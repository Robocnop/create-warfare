	quest.14B6D13AFF72434C.quest_desc: ["Canon, culasse, ressort et détente en fer : la base des pistolets.", "", "À faire avant (sinon la quête ne se valide pas) : « Table de recherche »."]
	quest.60EC125C4FDCB557.title: "Paquet de pièces en acier"
	quest.60EC125C4FDCB557.quest_desc: ["Les mêmes pièces en acier : fusils d'assaut, mitrailleuses, lance-roquettes. Plan + paquet + un dernier ingrédient à la table de forgeron.", "", "À faire avant (sinon la quête ne se valide pas) : « Paquet de pièces en fer »."]
	quest.14FDCCE9A9E143DD.title: "Munitions"
	quest.14FDCCE9A9E143DD.quest_desc: ["Cuivre, poudre et amorce. Les boîtes de munitions rechargent les chargeurs.", "", "À faire avant (sinon la quête ne se valide pas) : « Paquet de pièces en fer »."]
	quest.61552C1FCF733D30.title: "Plaques de blindage"
	quest.61552C1FCF733D30.quest_desc: ["À glisser dans un plastron : elles encaissent les balles à ta place.", "", "À faire avant (sinon la quête ne se valide pas) : « Paquet de pièces en acier »."]
	quest.590E1DF66C2E33E2.title: "Mortier"
	quest.590E1DF66C2E33E2.quest_desc: ["Tube, bipied et plaque de base en acier. Tire en cloche par-dessus les murs.", "", "À faire avant (sinon la quête ne se valide pas) : « Paquet de pièces en acier »."]
	quest.38330F4192811DCC.title: "Obus de mortier"
	quest.38330F4192811DCC.quest_desc: ["Acier, explosif et propulseur.", "", "À faire avant (sinon la quête ne se valide pas) : « Mortier »."]
	quest.79EB8C89B297E7BF.title: "Paquet de pièces en carbure"
	quest.79EB8C89B297E7BF.quest_desc: ["Le carbure cémenté vient de la scheelite (tungstène) : armes lourdes et modules d'armement des véhicules.", "", "À faire avant (sinon la quête ne se valide pas) : « Paquet de pièces en acier »."]
	quest.3EF61E230D0F669A.title: "Table de reforge"
	quest.3EF61E230D0F669A.quest_desc: ["Avec un processeur ancien : elle ajoute des améliorations (perks) à une arme.", "", "À faire avant (sinon la quête ne se valide pas) : « Paquet de pièces en carbure »."]
	chapter.681D600432C87CB6.title: "V · L'âge électrique"
	chapter.681D600432C87CB6.chapter_subtitle: ["Produire du courant demande de l'acier. Au bout : les circuits imprimés."]
	quest.04772DFD2EA8E417.title: "Fil de cuivre"
	quest.04772DFD2EA8E417.quest_desc: ["La base des circuits électriques.", "", "À faire avant (sinon la quête ne se valide pas) : « Acier » (chapitre « IV · L'âge de l'acier »)."]
	quest.697CD161FF05B721.title: "Alternateur"
	quest.697CD161FF05B721.quest_desc: ["Convertit la rotation en énergie. Depuis la 2.0.0, il demande des tôles d'acier : l'électricité vient après le haut fourneau.", "", "À faire avant (sinon la quête ne se valide pas) : « Fil de cuivre »."]
	quest.6F4FA44804A52F63.title: "Moteur électrique"
	quest.6F4FA44804A52F63.quest_desc: ["Et l'inverse : l'énergie en rotation.", "", "À faire avant (sinon la quête ne se valide pas) : « Alternateur »."]
	quest.384245FADAA21E36.title: "Connecteurs"
	quest.384245FADAA21E36.quest_desc: ["Relie tes machines avec des câbles.", "", "À faire avant (sinon la quête ne se valide pas) : « Fil de cuivre »."]
	quest.3EBE6915AF745BF1.title: "Accumulateur modulaire"
	quest.3EBE6915AF745BF1.quest_desc: ["Stocke l'énergie.", "", "À faire avant (sinon la quête ne se valide pas) : « Alternateur »."]
	quest.0EF0F7DACDFDA4F7.title: "Bobine Tesla"
	quest.0EF0F7DACDFDA4F7.quest_desc: ["Charge les objets... ou les ennemis.", "", "À faire avant (sinon la quête ne se valide pas) : « Accumulateur modulaire »."]
	quest.34BB47D89EA04A76.title: "Bobine de générateur (New Age)"
	quest.34BB47D89EA04A76.quest_desc: ["Bobine de génératrice de New Age : cuivre autour d'un bloc d'acier.", "", "À faire avant (sinon la quête ne se valide pas) : « Acier » (chapitre « IV · L'âge de l'acier »)."]
	quest.6BB3B83B504294F2.title: "Aimants"
	quest.6BB3B83B504294F2.quest_desc: ["Le cœur des générateurs New Age.", "", "À faire avant (sinon la quête ne se valide pas) : « Bobine de générateur (New Age) »."]
	quest.1779809A713F2A43.title: "Énergiseur"
	quest.1779809A713F2A43.quest_desc: ["Surcharge les matériaux avec l'électricité.", "", "À faire avant (sinon la quête ne se valide pas) : « Aimants »."]
	quest.637344CE2EF36490.title: "Générateur TFMG"
	quest.637344CE2EF36490.quest_desc: ["Réseau électrique industriel de TFMG.", "", "À faire avant (sinon la quête ne se valide pas) : « Alternateur »."]
	quest.7DA093DB118A42DD.title: "Fil de cuivre (Power Grid)"
	quest.7DA093DB118A42DD.quest_desc: ["Power Grid simule vraiment l'électricité : le courant ne passe que si le circuit forme une boucle, et un long fil perd de la tension.", "", "À faire avant (sinon la quête ne se valide pas) : « Acier » (chapitre « IV · L'âge de l'acier »)."]
	quest.3BC12EF7F7D14504.title: "Générateur Power Grid"
	quest.3BC12EF7F7D14504.quest_desc: ["Embrayage, rotors, commutateur et bobinages : le générateur se construit pièce par pièce (voir le ponder).", "", "À faire avant (sinon la quête ne se valide pas) : « Fil de cuivre (Power Grid) »."]
	quest.6EE17B94C458BBF3.title: "Moteur électrique (Power Grid)"
	quest.6EE17B94C458BBF3.quest_desc: ["Sa vitesse dépend de la tension fournie.", "", "À faire avant (sinon la quête ne se valide pas) : « Générateur Power Grid »."]
	quest.3F0FD706BDA92D56.title: "Panneaux solaires"
	quest.3F0FD706BDA92D56.quest_desc: ["De l'énergie sans carburant, si le soleil est dégagé.", "", "À faire avant (sinon la quête ne se valide pas) : « Fil de cuivre (Power Grid) »."]
	quest.78C49D56D67D20E5.title: "Onduleur FE"
	quest.78C49D56D67D20E5.quest_desc: ["Fait passer l'énergie FE des autres mods dans un réseau Power Grid.", "", "À faire avant (sinon la quête ne se valide pas) : « Générateur Power Grid », « Alternateur »."]
	quest.35249220763E79C4.title: "Circuits imprimés"
	quest.35249220763E79C4.quest_desc: ["Plaque gravée à l'acide, condensateur, résistances et transistor en assemblage séquencé. C'est la porte de la guerre mécanisée : radars, véhicules, établi de munitions.", "", "À faire avant (sinon la quête ne se valide pas) : « Alternateur », « Plastique » (chapitre « IV · L'âge de l'acier »)."]
	chapter.16A7BFA622EEA61D.title: "V · Défense \\& informatique"
	chapter.16A7BFA622EEA61D.chapter_subtitle: ["Ordinateurs pour piloter canons et avions, et une base qui se défend toute seule."]
	quest.51DA5E89D7D3F671.title: "Ordinateur"
	quest.51DA5E89D7D3F671.quest_desc: ["CC: Tweaked, avec des recettes passées par Create. Il pilote trains, gares et boîtes de vitesses séquencées.", "", "À faire avant (sinon la quête ne se valide pas) : « Tubes électroniques » (chapitre « III · L'âge du laiton »)."]
	quest.3635CA2A9238EDD0.title: "Modems filaires"
	quest.3635CA2A9238EDD0.quest_desc: ["Relie l'ordinateur aux machines voisines (périphériques).", "", "À faire avant (sinon la quête ne se valide pas) : « Ordinateur »."]
	quest.2F62A39BF6AD3800.title: "Moniteurs avancés"
	quest.2F62A39BF6AD3800.quest_desc: ["Un grand écran couleur pour tes tableaux de bord.", "", "À faire avant (sinon la quête ne se valide pas) : « Ordinateur »."]
	quest.3341112053D99015.title: "Canon piloté par ordinateur"
	quest.3341112053D99015.quest_desc: ["Avec CC:CBC, un ordinateur relié par modem à un affût de canon le vise et le fait tirer. Branche-le sur ton radar : la DCA devient automatique.", "", "À faire avant (sinon la quête ne se valide pas) : « Modems filaires », « Affût » (chapitre « IV · Artillerie »), « Antenne radar » (chapitre « VI · Radars \\& missiles »)."]
	quest.12AE20BF3CF08536.title: "Avionique"
	quest.12AE20BF3CF08536.quest_desc: ["Avec Create: Avionics, un ordinateur embarqué lit et commande les blocs Aeronautics (cap, altitude, hélices). Pilote automatique compris.", "", "À faire avant (sinon la quête ne se valide pas) : « Modems filaires », « Assembleur physique » (chapitre « IV · Aviation »)."]
	quest.6F8358FC1FA5F25A.title: "Tortue"
	quest.6F8358FC1FA5F25A.quest_desc: ["Un petit robot programmable : il mine, construit et transporte.", "", "À faire avant (sinon la quête ne se valide pas) : « Ordinateur », « Acier » (chapitre « IV · L'âge de l'acier »)."]
	quest.2C4721D77E50AA98.title: "Blocs laser"
	quest.2C4721D77E50AA98.quest_desc: ["Premier pas de SecurityCraft : une barrière invisible qui déclenche tes défenses.", "", "À faire avant (sinon la quête ne se valide pas) : « Alternateur » (chapitre « V · L'âge électrique »)."]
	quest.44F24B414E0DD228.title: "Renforceur universel"
	quest.44F24B414E0DD228.quest_desc: ["Transforme tes blocs en blocs renforcés que seuls toi et ton équipe pouvez casser. Les obus CBC, Superb Warfare et la TNT les abîment, mais les bombes et ICBM de Project: Explosive n'y font rien : parfait pour un bunker anti-nucléaire.", "", "À faire avant (sinon la quête ne se valide pas) : « Blocs laser », « Mécanisme de précision » (chapitre « III · L'âge du laiton »)."]
	quest.6EFD5A18CB66C8A0.title: "Murs renforcés"
	quest.6EFD5A18CB66C8A0.quest_desc: ["Les murs de ta base, ou de ton bunker : ils encaissent Fat Man et les ICBM, pas l'artillerie.", "", "À faire avant (sinon la quête ne se valide pas) : « Renforceur universel »."]
	quest.14BDCFD95D3B0B6A.title: "Clavier à code"
	quest.14BDCFD95D3B0B6A.quest_desc: ["Ferme une porte ou un coffre avec un code.", "", "À faire avant (sinon la quête ne se valide pas) : « Blocs laser »."]
	quest.6DD8CD9DA47BBC02.title: "Caméras de sécurité"
	quest.6DD8CD9DA47BBC02.quest_desc: ["Surveille ta base à distance avec un écran de caméras.", "", "À faire avant (sinon la quête ne se valide pas) : « Renforceur universel »."]
	quest.12BE8EA035108910.title: "Mines"
	quest.12BE8EA035108910.quest_desc: ["Pour les invités qui n'ont pas sonné.", "", "À faire avant (sinon la quête ne se valide pas) : « Blocs laser »."]
	quest.1813381F944EDFE5.title: "Radar portatif"
	quest.1813381F944EDFE5.quest_desc: ["Signale les joueurs qui approchent.", "", "À faire avant (sinon la quête ne se valide pas) : « Blocs laser »."]
	quest.053E2AB78B4CDD5A.title: "Tourelle"
	quest.053E2AB78B4CDD5A.quest_desc: ["Tire sur les intrus. Demande de l'acier et des tubes électroniques.", "", "À faire avant (sinon la quête ne se valide pas) : « Radar portatif », « Renforceur universel », « Acier » (chapitre « IV · L'âge de l'acier »)."]
	quest.3500B9C3283A3465.title: "Système Trophy"
	quest.3500B9C3283A3465.quest_desc: ["Abat les projectiles qui approchent. Demande des circuits imprimés TFMG.", "", "À faire avant (sinon la quête ne se valide pas) : « Tourelle »."]
	quest.0122626D68798D25.title: "Boîte de discussion"
	quest.0122626D68798D25.quest_desc: ["Advanced Peripherals : ton ordinateur peut écrire dans le chat et lire les messages.", "", "À faire avant (sinon la quête ne se valide pas) : « Ordinateur »."]
	quest.0C93B7A28BDAE8C0.title: "Détecteur de joueurs"
	quest.0C93B7A28BDAE8C0.quest_desc: ["Sait si un joueur est proche (64 blocs max. sur ce serveur, sans position exacte) : portes et alarmes automatiques.", "", "À faire avant (sinon la quête ne se valide pas) : « Ordinateur »."]
	quest.6892C51E74F31FFE.title: "Scanner géologique"
	quest.6892C51E74F31FFE.quest_desc: ["Liste les minerais autour de lui, pour programmer une tortue mineuse.", "", "À faire avant (sinon la quête ne se valide pas) : « Tortue »."]
	chapter.1AF3C82F48B4688F.title: "VI · Blindés"
	chapter.1AF3C82F48B4688F.chapter_subtitle: ["Roues, chenilles, blindage et tourelles pour les engins Sable."]
	quest.13E7484E1F2FE580.title: "Support de roue"
	quest.13E7484E1F2FE580.quest_desc: ["La base de tout véhicule terrestre.", "", "À faire avant (sinon la quête ne se valide pas) : « Acier » (chapitre « IV · L'âge de l'acier »)."]
	quest.5B83D33E942C54BE.title: "Pneus"
	quest.5B83D33E942C54BE.quest_desc: ["Montés sur les supports de roue.", "", "À faire avant (sinon la quête ne se valide pas) : « Support de roue »."]
	quest.29DD744F849AC3AB.title: "Gros pneus"
	quest.29DD744F849AC3AB.quest_desc: ["Pour les engins lourds.", "", "À faire avant (sinon la quête ne se valide pas) : « Pneus »."]
	quest.17BFE8A7DDC09824.title: "Blocs d'acier au carbone"
	quest.17BFE8A7DDC09824.quest_desc: ["Acier et coke au mélangeur chauffé donnent l'acier au carbone ; 4 lingots font un bloc. Protège tes véhicules et bunkers.", "", "À faire avant (sinon la quête ne se valide pas) : « Acier » (chapitre « IV · L'âge de l'acier »)."]
	quest.146D0F04611E9EB9.title: "Blindage réactif (ERA)"
	quest.146D0F04611E9EB9.quest_desc: ["Une charge de poudre déployée sur un bloc d'acier au carbone. Explose vers l'extérieur pour arrêter les obus.", "", "À faire avant (sinon la quête ne se valide pas) : « Blocs d'acier au carbone », « Charges de poudre » (chapitre « IV · Artillerie »)."]
	quest.1BD8EFC028544134.title: "Canon blindé (Armored Constructs)"
	quest.1BD8EFC028544134.quest_desc: ["Tourelles pour tes chars.", "", "À faire avant (sinon la quête ne se valide pas) : « Blocs d'acier au carbone »."]
	quest.3A8BB4E49C8BB3E6.title: "Tourelle chimique"
	quest.3A8BB4E49C8BB3E6.quest_desc: ["Lance-flammes automatique.", "", "À faire avant (sinon la quête ne se valide pas) : « Distillerie » (chapitre « IV · L'âge de l'acier »)."]
	quest.5175D0DB6E2EB7F9.title: "Périscope"
	quest.5175D0DB6E2EB7F9.quest_desc: ["Vision depuis l'intérieur du char.", "", "À faire avant (sinon la quête ne se valide pas) : « Blocs d'acier au carbone »."]
	chapter.7D0AF9B5A534D721.title: "VI · Guerre mécanisée"
	chapter.7D0AF9B5A534D721.chapter_subtitle: ["Les véhicules de Superb Warfare : acier, caoutchouc, moteurs électriques et électronique."]
	quest.228EFA51E63652C6.title: "Table d'assemblage de véhicules"
	quest.228EFA51E63652C6.quest_desc: ["Tôles d'acier, mécanisme en acier et circuit imprimé : la porte du palier VI. Tous les véhicules s'assemblent ici.", "", "À faire avant (sinon la quête ne se valide pas) : « Acier » (chapitre « IV · L'âge de l'acier »), « Circuits imprimés » (chapitre « V · L'âge électrique »)."]
	quest.3D829C3472E8A455.title: "Moteurs"
	quest.3D829C3472E8A455.quest_desc: ["Bobines de cuivre, arbre et tube électronique.", "", "À faire avant (sinon la quête ne se valide pas) : « Table d'assemblage de véhicules »."]
	quest.7E5861253655B447.title: "Gros moteur"
	quest.7E5861253655B447.quest_desc: ["Deux moteurs électriques de Crafts \\& Additions et un mécanisme en acier : le cœur de chaque véhicule.", "", "À faire avant (sinon la quête ne se valide pas) : « Moteurs », « Moteur électrique » (chapitre « V · L'âge électrique »)."]
	quest.049AE4060D0BC557.title: "Roues"
	quest.049AE4060D0BC557.quest_desc: ["Caoutchouc de TFMG (pétrole lourd et soufre) sur jante en acier.", "", "À faire avant (sinon la quête ne se valide pas) : « Table d'assemblage de véhicules », « Distillerie » (chapitre « IV · L'âge de l'acier »)."]
	quest.17490F3EB166A2D1.title: "Chenilles"
	quest.17490F3EB166A2D1.quest_desc: ["Des roues et de l'acier : pour les blindés.", "", "À faire avant (sinon la quête ne se valide pas) : « Roues »."]
	quest.42071AD892B5AC30.title: "Batterie moyenne"
	quest.42071AD892B5AC30.quest_desc: ["Assemblée à la table à partir de petites batteries. Elle se recharge à la station de charge.", "", "À faire avant (sinon la quête ne se valide pas) : « Table d'assemblage de véhicules »."]
	quest.4FEF7E6CB8C95C2A.title: "Module d'armement léger"
	quest.4FEF7E6CB8C95C2A.quest_desc: ["Pièces en acier et mécanisme de précision : mitrailleuses de bord.", "", "À faire avant (sinon la quête ne se valide pas) : « Table d'assemblage de véhicules », « Paquet de pièces en acier » (chapitre « II à VI · Armurerie »)."]
	quest.51E7F0EF597A926C.title: "Noyau de canon"
	quest.51E7F0EF597A926C.quest_desc: ["Il demande une vraie culasse coulissante de Create Big Cannons.", "", "À faire avant (sinon la quête ne se valide pas) : « Table d'assemblage de véhicules », « Culasse coulissante » (chapitre « IV · Artillerie »)."]
	quest.615D3CCFF694A28A.title: "Module d'armement moyen"
	quest.615D3CCFF694A28A.quest_desc: ["Carbure cémenté : canons automatiques des blindés légers.", "", "À faire avant (sinon la quête ne se valide pas) : « Module d'armement léger », « Paquet de pièces en carbure » (chapitre « II à VI · Armurerie »)."]
	quest.028DECCE43A91A35.title: "Module d'armement lourd"
	quest.028DECCE43A91A35.quest_desc: ["Noyau de canon, netherite et module moyen : chars de combat et avions d'attaque.", "", "À faire avant (sinon la quête ne se valide pas) : « Module d'armement moyen », « Noyau de canon »."]
	quest.7C66996644ECAF71.title: "Premier véhicule"
	quest.7C66996644ECAF71.quest_desc: ["Assemble ton premier véhicule à la table (un pick-up suffit) et prends sa clé. Coche la quête quand il roule.", "", "À faire avant (sinon la quête ne se valide pas) : « Gros moteur », « Roues », « Batterie moyenne »."]
	quest.2CF3B0CD219BAE24.title: "Outil de réparation"
	quest.2CF3B0CD219BAE24.quest_desc: ["Un véhicule abîmé se répare, il ne se remplace pas.", "", "À faire avant (sinon la quête ne se valide pas) : « Premier véhicule »."]
	chapter.47DA1C59EB2CE985.title: "VI · Radars \\& missiles"
	chapter.47DA1C59EB2CE985.chapter_subtitle: ["Détecter, suivre et frapper à longue distance. Et abattre ce qui arrive."]
	quest.77E3E4D638A041C4.title: "Jumelles"
	quest.77E3E4D638A041C4.quest_desc: ["Repérage et désignation de cibles.", "", "À faire avant (sinon la quête ne se valide pas) : « Alternateur » (chapitre « V · L'âge électrique »)."]
	quest.764793E12A209AEB.title: "Roulement de radar"
	quest.764793E12A209AEB.quest_desc: ["Le pivot du radar : roulement mécanique, tôles d'acier et circuit imprimé.", "", "À faire avant (sinon la quête ne se valide pas) : « Circuits imprimés » (chapitre « V · L'âge électrique »)."]
	quest.2B6DCB051C43594F.title: "Antenne radar"
	quest.2B6DCB051C43594F.quest_desc: ["Détecte avions et navires.", "", "À faire avant (sinon la quête ne se valide pas) : « Roulement de radar »."]
	quest.39F9BD3B7CF5FEEF.title: "Écran radar"
	quest.39F9BD3B7CF5FEEF.quest_desc: ["Affiche les contacts.", "", "À faire avant (sinon la quête ne se valide pas) : « Antenne radar »."]
	quest.69A8DDF795F0DA59.title: "Conduite de tir"
	quest.69A8DDF795F0DA59.quest_desc: ["Relie radar et canons.", "", "À faire avant (sinon la quête ne se valide pas) : « Écran radar »."]
	quest.3E0317F5F0964CCF.title: "Transpondeur IFF"
	quest.3E0317F5F0964CCF.quest_desc: ["Ami ou ennemi ?", "", "À faire avant (sinon la quête ne se valide pas) : « Antenne radar »."]
	quest.27B565817BA421AC.title: "Radar d'avion"
	quest.27B565817BA421AC.quest_desc: ["Radar compact à embarquer sur tes appareils.", "", "À faire avant (sinon la quête ne se valide pas) : « Antenne radar »."]
	quest.58B19C6FE111E7F3.title: "AIM-9 Sidewinder"
	quest.58B19C6FE111E7F3.quest_desc: ["Missile air-air guidé.", "", "À faire avant (sinon la quête ne se valide pas) : « Conduite de tir »."]
	quest.33AAAE60BA29B4DD.title: "Patriot"
	quest.33AAAE60BA29B4DD.quest_desc: ["Défense antimissile.", "", "À faire avant (sinon la quête ne se valide pas) : « AIM-9 Sidewinder »."]
	quest.68B6E8B7239C1A49.title: "Tomahawk"
	quest.68B6E8B7239C1A49.quest_desc: ["Missile de croisière longue portée : demande des Codes de lancement.", "", "À faire avant (sinon la quête ne se valide pas) : « Conduite de tir », « Codes de lancement » (chapitre « VII · Dissuasion »)."]
	quest.31F9D5BE8608A54A.title: "Pas de tir (Create Missiles)"
	quest.31F9D5BE8608A54A.quest_desc: ["Pas de tir de Create Missiles : tôle d'acier, boîtier en laiton et circuit imprimé.", "", "À faire avant (sinon la quête ne se valide pas) : « Acier » (chapitre « IV · L'âge de l'acier »), « Circuits imprimés » (chapitre « V · L'âge électrique »)."]
	quest.183A1FBA2348EB6B.title: "Ogive (Create Missiles)"
	quest.183A1FBA2348EB6B.quest_desc: ["La charge utile. Les ogives destructrices demandent des obus HE.", "", "À faire avant (sinon la quête ne se valide pas) : « Pas de tir (Create Missiles) », « Obus explosifs » (chapitre « IV · Artillerie »)."]
	quest.7A09796CAB0A8D01.title: "Détecteur de drones"
	quest.7A09796CAB0A8D01.quest_desc: ["Capte la vidéo des drones FPV et entend les Mavic. Clic droit : signal suivant.", "", "À faire avant (sinon la quête ne se valide pas) : « Antenne radar »."]
	quest.5EDC4ACD5A6310BC.title: "Brouilleur de guerre électronique"
	quest.5EDC4ACD5A6310BC.quest_desc: ["Coupe la liaison des drones ennemis autour de lui. Il lui faut une batterie de Superb Warfare.", "", "À faire avant (sinon la quête ne se valide pas) : « Détecteur de drones »."]
	quest.51159891E8BD3D4D.title: "Drone FPV"
	quest.51159891E8BD3D4D.quest_desc: ["Un drone kamikaze piloté en vue immersive. Compatible manette et radiocommande.", "", "À faire avant (sinon la quête ne se valide pas) : « Détecteur de drones »."]
	quest.59B56E96E4915DC7.title: "Sirène d'alerte aérienne"
	quest.59B56E96E4915DC7.quest_desc: ["Préviens ta base qu'un raid arrive.", "", "À faire avant (sinon la quête ne se valide pas) : « Antenne radar »."]
	quest.0AFBA63465BCBB12.title: "Terminal de drones"
	quest.0AFBA63465BCBB12.quest_desc: ["Associe tes Shahed (clic avec le drone en main), trace leur itinéraire sur la carte et lance-les.", "", "À faire avant (sinon la quête ne se valide pas) : « Conduite de tir »."]
	quest.56FCFD033584A67D.title: "Shahed-136"
	quest.56FCFD033584A67D.quest_desc: ["Drone d'attaque à longue portée, posé sur une rampe de lancement.", "", "À faire avant (sinon la quête ne se valide pas) : « Terminal de drones »."]
	quest.794F4CB9C8DE1C89.title: "Rampe de lancement"
	quest.794F4CB9C8DE1C89.quest_desc: ["Le Shahed ne se pose que dessus.", "", "À faire avant (sinon la quête ne se valide pas) : « Terminal de drones »."]
	quest.4E1AB0FC7277B1BE.title: "Clé du CIWS"
	quest.4E1AB0FC7277B1BE.quest_desc: ["Accroupi sur un CIWS H/PJ-11 de Superb Warfare : choisis les joueurs qu'il ne doit pas viser.", "", "À faire avant (sinon la quête ne se valide pas) : « Conduite de tir »."]
	chapter.04EF504505BA1E93.title: "VII · L'atome"
	chapter.04EF504505BA1E93.chapter_subtitle: ["Uranium, thorium et réacteurs : une énergie massive, et la matière des bombes."]
	quest.39EBE17E2F842A13.title: "Uranium brut"
	quest.39EBE17E2F842A13.quest_desc: ["Minerai radioactif : protège-toi.", "", "À faire avant (sinon la quête ne se valide pas) : « Alternateur » (chapitre « V · L'âge électrique »), « Acier » (chapitre « IV · L'âge de l'acier »)."]
	quest.6415F51C0ECAA426.title: "Plomb"
	quest.6415F51C0ECAA426.quest_desc: ["Écran contre les radiations.", "", "À faire avant (sinon la quête ne se valide pas) : « Alternateur » (chapitre « V · L'âge électrique »), « Acier » (chapitre « IV · L'âge de l'acier »)."]
	quest.7E3061CC3BBDF79B.title: "Casque antiradiation"
	quest.7E3061CC3BBDF79B.quest_desc: ["Équipement de protection, pièce 1.", "", "À faire avant (sinon la quête ne se valide pas) : « Plomb »."]
	quest.301C30713E05F5F2.title: "Plastron antiradiation"
	quest.301C30713E05F5F2.quest_desc: ["Pièce 2.", "", "À faire avant (sinon la quête ne se valide pas) : « Casque antiradiation »."]
	quest.5BEDFC712C018B4D.title: "Jambières antiradiation"
	quest.5BEDFC712C018B4D.quest_desc: ["Pièce 3.", "", "À faire avant (sinon la quête ne se valide pas) : « Plastron antiradiation »."]
	quest.1BF43313539FD41B.title: "Bottes antiradiation"
	quest.1BF43313539FD41B.quest_desc: ["Pièce 4 : la tenue est complète.", "", "À faire avant (sinon la quête ne se valide pas) : « Jambières antiradiation »."]
	quest.531F7DD09656D0AD.title: "Yellowcake enrichi"
	quest.531F7DD09656D0AD.quest_desc: ["Combustible enrichi.", "", "À faire avant (sinon la quête ne se valide pas) : « Uranium brut »."]
	quest.6072A0EE60401705.title: "Barres de graphite"
	quest.6072A0EE60401705.quest_desc: ["Modèrent la réaction."]
	quest.26663CF49A7D8865.title: "Boîtier de réacteur"
	quest.26663CF49A7D8865.quest_desc: ["La coque du réacteur.", "", "À faire avant (sinon la quête ne se valide pas) : « Plomb »."]
	quest.20C2A9274845556B.title: "Contrôleur de réacteur"
	quest.20C2A9274845556B.quest_desc: ["Pilote le réacteur.", "", "À faire avant (sinon la quête ne se valide pas) : « Boîtier de réacteur »."]
	quest.3864BD2C040A8119.title: "Barres d'uranium"
	quest.3864BD2C040A8119.quest_desc: ["Le combustible du réacteur.", "", "À faire avant (sinon la quête ne se valide pas) : « Yellowcake enrichi »."]
	quest.4F22817667213C8D.title: "Cœur de réacteur"
	quest.4F22817667213C8D.quest_desc: ["Là où tout se passe.", "", "À faire avant (sinon la quête ne se valide pas) : « Contrôleur de réacteur », « Barres de graphite », « Barres d'uranium »."]
	quest.46FC1420DE526E77.title: "Alarme de réacteur"
	quest.46FC1420DE526E77.quest_desc: ["Prévient avant la fusion.", "", "À faire avant (sinon la quête ne se valide pas) : « Cœur de réacteur »."]
	quest.03501335E22DFE6C.title: "Thorium (New Age)"
	quest.03501335E22DFE6C.quest_desc: ["Combustible des réacteurs New Age.", "", "À faire avant (sinon la quête ne se valide pas) : « Alternateur » (chapitre « V · L'âge électrique »), « Acier » (chapitre « IV · L'âge de l'acier »)."]
	quest.32582178B42BF6F2.title: "Barres de réacteur New Age"
	quest.32582178B42BF6F2.quest_desc: ["Second type de réacteur.", "", "À faire avant (sinon la quête ne se valide pas) : « Thorium (New Age) »."]
	chapter.57C2176FB3D9A403.title: "VII · Espace"
	chapter.57C2176FB3D9A403.chapter_subtitle: ["Titane, circuits et fusées : la Lune, puis Mars, Mercure et Vénus (Northstar)."]
	quest.6D5B291D9D5DCA92.title: "Télescope"
	quest.6D5B291D9D5DCA92.quest_desc: ["Laiton, éclat d'améthyste et bâtons. La nuit, clic droit avec du papier : tu obtiens un relevé astronomique de la planète visée.", "", "À faire avant (sinon la quête ne se valide pas) : « Laiton » (chapitre « III · L'âge du laiton »)."]
	quest.504DE8797372588C.title: "Concentré de rutile"
	quest.504DE8797372588C.quest_desc: ["Le minerai de titane de la Terre. Le broyeur en tire du sable (25 %) ou du calcaire (50 %, par deux).", "", "À faire avant (sinon la quête ne se valide pas) : « Laiton » (chapitre « III · L'âge du laiton »)."]
	quest.413BD90157D70A23.title: "Sel"
	quest.413BD90157D70A23.quest_desc: ["Basalte broyé : 2 à 4 sels.", "", "À faire avant (sinon la quête ne se valide pas) : « Laiton » (chapitre « III · L'âge du laiton »)."]
	quest.6E57D9D4BB97984D.title: "Catalyseur au sodium"
	quest.6E57D9D4BB97984D.quest_desc: ["Un sel arrosé de lave par un bec verseur.", "", "À faire avant (sinon la quête ne se valide pas) : « Sel »."]
	quest.0A89AE921FF3784A.title: "Tétrachlorure de titane"
	quest.0A89AE921FF3784A.quest_desc: ["Mélangeur sur brûleur surchauffé : 3 rutiles, 1 catalyseur, 1 zinc et du carbone liquide (3 charbons compactés sur brûleur allumé).", "", "À faire avant (sinon la quête ne se valide pas) : « Concentré de rutile », « Catalyseur au sodium », « Brûleur à blaze » (chapitre « III · L'âge du laiton »)."]
	quest.15142AF3BCA06E7A.title: "Titane"
	quest.15142AF3BCA06E7A.quest_desc: ["Séquence sur une plaque robuste de Create : lave, presse, tétrachlorure, presse, eau. La fonte liquide de CBC peut remplacer la lave. Hors de la Terre, le minerai de titane se fond directement.", "", "À faire avant (sinon la quête ne se valide pas) : « Tétrachlorure de titane », « Mécanisme de précision » (chapitre « III · L'âge du laiton »)."]
	quest.1CAB18184BA3CF04.title: "Atlas spatial"
	quest.1CAB18184BA3CF04.quest_desc: ["Un livre et un lingot de titane. Il garde les planètes découvertes et les balises, et se pose dans la station de fusée pour choisir la destination.", "", "À faire avant (sinon la quête ne se valide pas) : « Titane », « Télescope »."]
	quest.73B4EFF5859488E3.title: "Table d'astronomie"
	quest.73B4EFF5859488E3.quest_desc: ["Atlas + relevés astronomiques = science. Assez de science débloque une planète. Les relevés de planètes différentes rapportent plus ; un seul relevé par planète et par jour.", "", "À faire avant (sinon la quête ne se valide pas) : « Atlas spatial »."]
	quest.4B915DCCDD665D2A.title: "Cristal d'améthyste"
	quest.4B915DCCDD665D2A.quest_desc: ["Améthystes polies au papier de verre, redstone et fer. Le cœur du graveur de circuits.", "", "À faire avant (sinon la quête ne se valide pas) : « Laiton » (chapitre « III · L'âge du laiton »)."]
	quest.14A3C6ECD05A512F.title: "Graveur de circuits"
	quest.14A3C6ECD05A512F.quest_desc: ["Fabricants mécaniques : titane, quartz rose poli, mécanisme de précision et cristal d'améthyste. Il fait l'étape de gravure des circuits.", "", "À faire avant (sinon la quête ne se valide pas) : « Titane », « Cristal d'améthyste », « Fabricants mécaniques » (chapitre « III · L'âge du laiton »)."]
	quest.3E8548C11299A4CC.title: "Circuits"
	quest.3E8548C11299A4CC.quest_desc: ["Séquence sur une plaque de fer : améthyste polie, plaque de cuivre, plaque d'or, puis gravure. Il en faut partout.", "", "À faire avant (sinon la quête ne se valide pas) : « Graveur de circuits »."]
	quest.6A5EC12FB6CCB26A.title: "Mécanisme de précision durci"
	quest.6A5EC12FB6CCB26A.quest_desc: ["Séquence sur un mécanisme de précision : pépite de titane, roue dentée en fer, grande roue dentée en fer (arbre + bloc de fer industriel).", "", "À faire avant (sinon la quête ne se valide pas) : « Titane », « Mécanisme de précision » (chapitre « III · L'âge du laiton »)."]
	quest.71C8BC723873506B.title: "Ordinateur de visée"
	quest.71C8BC723873506B.quest_desc: ["Séquence sur une plaque de fer : diamant poli (au papier de verre), mécanisme durci, gravure, circuit, gravure.", "", "À faire avant (sinon la quête ne se valide pas) : « Circuits », « Mécanisme de précision durci »."]
	quest.08317F95AFF3791C.title: "Séparateur d'oxygène"
	quest.08317F95AFF3791C.quest_desc: ["Plaques de fer, tube électronique et tuyaux.", "", "À faire avant (sinon la quête ne se valide pas) : « Tubes électroniques » (chapitre « III · L'âge du laiton »)."]
	quest.2F64312ED1A8F692.title: "Concentrateur atmosphérique"
	quest.2F64312ED1A8F692.quest_desc: ["Récupère l'oxygène (ou le carbone) de l'air. La première source d'oxygène, avant l'électrolyse.", "", "À faire avant (sinon la quête ne se valide pas) : « Séparateur d'oxygène », « Circuits »."]
	quest.64D3BB42E011CA4E.title: "Combinaison spatiale"
	quest.64D3BB42E011CA4E.quest_desc: ["Armure en fer + tissu résistant + plaques de fer ; le plastron contient une citerne dorsale en cuivre. Fais aussi le casque (verre teinté), les jambières et les bottes.", "", "À faire avant (sinon la quête ne se valide pas) : « Séparateur d'oxygène »."]
	quest.0C3659764E5D4D51.title: "Remplisseur d'oxygène"
	quest.0C3659764E5D4D51.quest_desc: ["Pompe de l'oxygène dedans, puis clic droit avec la combinaison : il la remplit. Sans oxygène, on meurt vite hors de la Terre.", "", "À faire avant (sinon la quête ne se valide pas) : « Combinaison spatiale », « Circuits », « Concentrateur atmosphérique »."]
	quest.6BFE111144953C41.title: "Chambre de combustion"
	quest.6BFE111144953C41.quest_desc: ["Titane, séparateur d'oxygène, mécanisme durci et hélice.", "", "À faire avant (sinon la quête ne se valide pas) : « Mécanisme de précision durci », « Séparateur d'oxygène »."]
	quest.599A5BD6A4315027.title: "Propulseurs de fusée"
	quest.599A5BD6A4315027.quest_desc: ["Le nombre nécessaire dépend du poids de la fusée et de la gravité des deux planètes : la station de fusée te le dit.", "", "À faire avant (sinon la quête ne se valide pas) : « Chambre de combustion »."]
	quest.7765641F001D0799.title: "Commandes de fusée"
	quest.7765641F001D0799.quest_desc: ["Le poste de pilotage. Fixe-le à la fusée avec de la super colle, sinon l'assemblage échoue.", "", "À faire avant (sinon la quête ne se valide pas) : « Circuits »."]
	quest.70B87AA0A32DC1F0.title: "Station de fusée"
	quest.70B87AA0A32DC1F0.quest_desc: ["Assemble la fusée construite au-dessus. Pose l'atlas dedans pour choisir la destination ; elle affiche le carburant, les propulseurs et le bouclier thermique qui manquent.", "", "À faire avant (sinon la quête ne se valide pas) : « Ordinateur de visée », « Mécanisme de précision durci »."]
	quest.7B6D4A7934E9A892.title: "Un petit pas"
	quest.7B6D4A7934E9A892.quest_desc: ["Carburant dans des réservoirs de fluides à bord (liste dans JEI depuis la station ; la quantité dépend de la gravité et de la distance), blocs de métal pour le bouclier thermique, combinaison remplie. Assemble, monte aux commandes, saute pour lancer. Rapporte de la pierre lunaire.", "", "À faire avant (sinon la quête ne se valide pas) : « Station de fusée », « Propulseurs de fusée », « Commandes de fusée », « Table d'astronomie », « Remplisseur d'oxygène »."]
	quest.35A1510FB9FC9A56.title: "Saphir lunaire"
	quest.35A1510FB9FC9A56.quest_desc: ["Dans les géodes de la Lune. Poli au papier de verre, il sert au navigateur et aux circuits avancés.", "", "À faire avant (sinon la quête ne se valide pas) : « Un petit pas »."]
	quest.273651B7469170DB.title: "Baie informatique"
	quest.273651B7469170DB.quest_desc: ["Des ordinateurs de visée rangés dans des baies à bord réduisent la consommation de carburant.", "", "À faire avant (sinon la quête ne se valide pas) : « Ordinateur de visée »."]
	quest.6FBE4298438CCADF.title: "Navigateur interplanétaire"
	quest.6FBE4298438CCADF.quest_desc: ["Saphirs lunaires polis, circuits, titane et un ordinateur de visée. La station indique les voyages où il est obligatoire.", "", "À faire avant (sinon la quête ne se valide pas) : « Saphir lunaire », « Ordinateur de visée »."]
	quest.4A696EE8826569F3.title: "Acier martien"
	quest.4A696EE8826569F3.quest_desc: ["Sur Mars : fer martien brut + cendre volcanique + titane, compactés sur brûleur allumé, donnent 2 lingots.", "", "À faire avant (sinon la quête ne se valide pas) : « Navigateur interplanétaire »."]
	quest.59C889F6DEC55A50.title: "Combinaison en acier martien"
	quest.59C889F6DEC55A50.quest_desc: ["Même recette que la combinaison en fer, avec l'armure et les plaques d'acier martien.", "", "À faire avant (sinon la quête ne se valide pas) : « Acier martien »."]
	quest.55C75DE1801B0C73.title: "Machine d'électrolyse"
	quest.55C75DE1801B0C73.quest_desc: ["L'eau devient hydrogène et oxygène ; la saumure (sel + eau) donne chlore et sodium.", "", "À faire avant (sinon la quête ne se valide pas) : « Acier martien », « Circuits »."]
	quest.7637C9C1D3F05A33.title: "Scelleur d'oxygène"
	quest.7637C9C1D3F05A33.quest_desc: ["Oxygène par l'arrière, rotation par le dessous : il remplit d'air une base fermée. Le grand ventilateur en titane agrandit la zone.", "", "À faire avant (sinon la quête ne se valide pas) : « Remplisseur d'oxygène »."]
	quest.4F38F22EE2169CA2.title: "Circuit avancé"
	quest.4F38F22EE2169CA2.quest_desc: ["Séquence sur un circuit : saphir lunaire poli, plaque d'acier martien, plaque d'or, gravure.", "", "À faire avant (sinon la quête ne se valide pas) : « Saphir lunaire », « Acier martien »."]
	quest.5CCA89FBA8469754.title: "Régulateur de température"
	quest.5CCA89FBA8469754.quest_desc: ["Glace bleue, bâtons de blaze et circuits avancés : rend vivable une base sur Mercure ou Vénus.", "", "À faire avant (sinon la quête ne se valide pas) : « Circuit avancé »."]
	quest.1BF6E5A1A579303C.title: "Tungstène"
	quest.1BF6E5A1A579303C.quest_desc: ["Sur Mercure. Le minerai broyé puis lavé donne 9 pépites.", "", "À faire avant (sinon la quête ne se valide pas) : « Navigateur interplanétaire »."]
	quest.72402A23BE04B03D.title: "Balise de fusée"
	quest.72402A23BE04B03D.quest_desc: ["Clic droit dessus avec l'atlas : la fusée pourra atterrir exactement à cet endroit.", "", "À faire avant (sinon la quête ne se valide pas) : « Tungstène », « Ordinateur de visée »."]
	quest.6CECD95D21D3333B.title: "Station d'atterrissage automatique"
	quest.6CECD95D21D3333B.quest_desc: ["Fait atterrir la fusée sans danger, sans pilote.", "", "À faire avant (sinon la quête ne se valide pas) : « Saphir lunaire », « Station de fusée »."]
	quest.5FF44D51B7519262.title: "Panneau solaire"
	quest.5FF44D51B7519262.quest_desc: ["Verre teinté, titane et circuit sur un arbre : de la rotation tirée du soleil.", "", "À faire avant (sinon la quête ne se valide pas) : « Circuits »."]
	chapter.41960E5E13891BC1.title: "VII · Dissuasion"
	chapter.41960E5E13891BC1.chapter_subtitle: ["La fin de partie : bombes lourdes et ICBM nucléaires. Avec modération..."]
	quest.74D2A1F364AADF7C.title: "Établi de munitions"
	quest.74D2A1F364AADF7C.quest_desc: ["Assemble bombes, ogives et missiles. Tôles et bloc d'acier, mécanismes en acier, circuits imprimés et un fabricant mécanique.", "", "À faire avant (sinon la quête ne se valide pas) : « Acier » (chapitre « IV · L'âge de l'acier »), « Circuits imprimés » (chapitre « V · L'âge électrique »)."]
	quest.4B2F05AFDAF2B237.title: "Bombe Mk 82"
	quest.4B2F05AFDAF2B237.quest_desc: ["Bombe d'aviation légère.", "", "À faire avant (sinon la quête ne se valide pas) : « Établi de munitions »."]
	quest.282FEA33AE7FE437.title: "Bombe Mk 84"
	quest.282FEA33AE7FE437.quest_desc: ["Bombe d'aviation lourde.", "", "À faire avant (sinon la quête ne se valide pas) : « Bombe Mk 82 »."]
	quest.0E1A85CD7654EC56.title: "Appel de frappe aérienne"
	quest.0E1A85CD7654EC56.quest_desc: ["Cinq Mk 82 sur la cible. Il demande une conduite de tir (chaîne radar) et un circuit imprimé.", "", "À faire avant (sinon la quête ne se valide pas) : « Bombe Mk 84 », « Conduite de tir » (chapitre « VI · Radars \\& missiles »)."]
	quest.66775A330665F94C.title: "Lunettes anti-flash"
	quest.66775A330665F94C.quest_desc: ["Pour regarder le champignon sans devenir aveugle.", "", "À faire avant (sinon la quête ne se valide pas) : « Établi de munitions »."]
	quest.2AD09B2F01C16648.title: "Compteur Geiger"
	quest.2AD09B2F01C16648.quest_desc: ["Mesure les retombées.", "", "À faire avant (sinon la quête ne se valide pas) : « Établi de munitions »."]
	quest.4F02DCB64718598B.title: "Lingots d'uranium"
	quest.4F02DCB64718598B.quest_desc: ["Matière fissile : 4 yellowcakes enrichis et du plomb, compactés sous brûleur surchauffé.", "", "À faire avant (sinon la quête ne se valide pas) : « Établi de munitions », « Yellowcake enrichi » (chapitre « VII · L'atome »)."]
	quest.6A4B67DC521A8EBE.title: "Système de visée"
	quest.6A4B67DC521A8EBE.quest_desc: ["Désigne la cible de l'ICBM. Longue-vue, boussole, circuit imprimé et un ordinateur de visée de Northstar (titane).", "", "À faire avant (sinon la quête ne se valide pas) : « Établi de munitions », « Ordinateur de visée » (chapitre « VII · Espace »)."]
	quest.624917B0AC01463C.title: "Codes de lancement"
	quest.624917B0AC01463C.quest_desc: ["Indispensables pour armer un ICBM ou une Fat Man (tenus en main secondaire à la pose) et pour les missiles longue portée. Quête répétable : 8 circuits imprimés, 16 yellowcakes enrichis et 4 mécanismes de précision renforcés sont consommés, une fois par équipe, puis délai de 4 h.", "", "À faire avant (sinon la quête ne se valide pas) : « Établi de munitions », « Yellowcake enrichi » (chapitre « VII · L'atome »), « Mécanisme de précision durci » (chapitre « VII · Espace »)."]
	quest.5CF5DE993A303811.title: "ICBM léger"
	quest.5CF5DE993A303811.quest_desc: ["Premier missile balistique. Sa pose consomme des Codes de lancement.", "", "À faire avant (sinon la quête ne se valide pas) : « Système de visée », « Codes de lancement »."]
	quest.14F3D1B8E9E9E22F.title: "ICBM lourd"
	quest.14F3D1B8E9E9E22F.quest_desc: ["Plus gros, plus loin.", "", "À faire avant (sinon la quête ne se valide pas) : « ICBM léger »."]
	quest.5FC9A9FB2250304D.title: "Fat Man"
	quest.5FC9A9FB2250304D.quest_desc: ["La bombe nucléaire larguée. Comme un ICBM, elle ne s'arme qu'avec des Codes de lancement, et tout le serveur est prévenu.", "", "À faire avant (sinon la quête ne se valide pas) : « Lingots d'uranium », « Bombe Mk 84 », « Codes de lancement »."]
	quest.5CD90A2B6E78FBBB.title: "ICBM nucléaire"
	quest.5CD90A2B6E78FBBB.quest_desc: ["L'arme ultime. Le serveur s'en souviendra.", "", "À faire avant (sinon la quête ne se valide pas) : « ICBM lourd », « Fat Man », « Lunettes anti-flash »."]
	chapter.5C329C6DE6204446.title: "Vie de camp · Cuisine"
	chapter.5C329C6DE6204446.chapter_subtitle: ["Kaleidoscope Cookery : cuisiner pour tenir entre deux batailles."]
	quest.286285B15331B404.title: "Fourneau"
	quest.286285B15331B404.quest_desc: ["La base de la cuisine : pose un wok ou une marmite dessus."]
	quest.1FA1339164ED206D.title: "Couteau de cuisine"
	quest.1FA1339164ED206D.quest_desc: ["Pour découper sur la planche."]
	quest.6718BE632F527AA2.title: "Planche à découper"
	quest.6718BE632F527AA2.quest_desc: ["Découpe viandes et légumes.", "", "À faire avant (sinon la quête ne se valide pas) : « Couteau de cuisine »."]
	quest.21A65A2702955B75.title: "Wok"
	quest.21A65A2702955B75.quest_desc: ["Sauté rapide sur le fourneau, avec la spatule.", "", "À faire avant (sinon la quête ne se valide pas) : « Fourneau »."]
	quest.60135E9F91129E15.title: "Marmite"
	quest.60135E9F91129E15.quest_desc: ["Soupes et ragoûts mijotés.", "", "À faire avant (sinon la quête ne se valide pas) : « Fourneau »."]
	quest.6D5225B21A033C13.title: "Nouvelles graines"
	quest.6D5225B21A033C13.quest_desc: ["Tomates, piments, laitue et riz. Le chapeau de paille fait tomber des graines des herbes."]
	quest.3A4B453B4ACF67F8.title: "Riz cuit"
	quest.3A4B453B4ACF67F8.quest_desc: ["La base des bols de riz.", "", "À faire avant (sinon la quête ne se valide pas) : « Nouvelles graines », « Marmite »."]
	quest.4370E6FB8E8803A0.title: "Moulin"
	quest.4370E6FB8E8803A0.quest_desc: ["Farine, huile et riz décortiqué. Le moulin de Create fait aussi ses recettes.", "", "À faire avant (sinon la quête ne se valide pas) : « Alliage d'andésite » (chapitre « II · L'âge de l'engrenage »)."]
	quest.473344BEB37CC400.title: "Œufs au plat"
	quest.473344BEB37CC400.quest_desc: ["Premier plat au wok.", "", "À faire avant (sinon la quête ne se valide pas) : « Wok »."]
	quest.40815A7E1BB832A8.title: "Bol de bœuf braisé"
	quest.40815A7E1BB832A8.quest_desc: ["Un vrai repas de soldat.", "", "À faire avant (sinon la quête ne se valide pas) : « Riz cuit », « Planche à découper »."]
	quest.36D2FAFFBDEE0624.title: "Cuiseur vapeur"
	quest.36D2FAFFBDEE0624.quest_desc: ["Brioches et raviolis à la vapeur.", "", "À faire avant (sinon la quête ne se valide pas) : « Marmite »."]
	chapter.7431026B20119ED0.title: "Vie de camp · Téléphones"
	chapter.7431026B20119ED0.chapter_subtitle: ["Mobile Networks : un numéro, des antennes, et ton équipe au bout du fil."]
	quest.2C60F068C888C626.title: "Ton téléphone"
	quest.2C60F068C888C626.quest_desc: ["Plaques de fer, tube électronique, fil de cuivre et vitre. Clic droit pour l'ouvrir. Tu as déjà un numéro à 9 chiffres, attribué automatiquement et gardé d'une session à l'autre. Sans antenne à portée, le téléphone affiche « Pas de service ».", "", "À faire avant (sinon la quête ne se valide pas) : « Tubes électroniques » (chapitre « III · L'âge du laiton »)."]
	quest.1D38A83442725EB6.title: "Tournevis"
	quest.1D38A83442725EB6.quest_desc: ["Un bâton et une pépite de fer. Clic droit sur une antenne avec le tournevis : sa configuration s'ouvre."]
	quest.2899F01C5C1DE412.title: "Antenne en cuivre"
	quest.2899F01C5C1DE412.quest_desc: ["Pose-la, puis ouvre-la au tournevis : crée ton réseau (donne-lui un nom) et allume-le. Dans le téléphone, « Chercher des réseaux » puis choisis le tien. Le signal va de E à 5G+ selon la distance et le terrain : plus tu t'éloignes, plus il baisse.", "", "À faire avant (sinon la quête ne se valide pas) : « Ton téléphone », « Tournevis »."]
	quest.63BBEFCAB43022C8.title: "Premier appel"
	quest.63BBEFCAB43022C8.quest_desc: ["Application Téléphone : la liste des joueurs en ligne et leurs numéros. Appelle un coéquipier : vous devez avoir du réseau tous les deux. Une fois décroché, vous vous parlez avec Simple Voice Chat, où que vous soyez (micro, sourdine et haut-parleur dans l'appel). Sur ce serveur, la voix de proximité et le chat textuel restent actifs. Coche la quête après ton premier appel.", "", "À faire avant (sinon la quête ne se valide pas) : « Antenne en cuivre »."]
	quest.5FB3005001FED898.title: "Messages"
	quest.5FB3005001FED898.quest_desc: ["Application Messages : SMS à un joueur, ou discussion de groupe pour toute l'équipe. Ça marche même quand le destinataire est loin, tant que vous avez du réseau. Coche la quête après ton premier message.", "", "À faire avant (sinon la quête ne se valide pas) : « Antenne en cuivre »."]
	quest.2BFA7C878E020522.title: "Antenne en fer"
	quest.2BFA7C878E020522.quest_desc: ["Deux fois la portée de l'antenne en cuivre. Des antennes proches l'une de l'autre peuvent se lier : leurs réseaux se partagent et la couverture s'étend de proche en proche.", "", "À faire avant (sinon la quête ne se valide pas) : « Antenne en cuivre »."]
	quest.7E8256A237BB782C.title: "Antenne en diamant"
	quest.7E8256A237BB782C.quest_desc: ["Quatre fois la portée de l'antenne en cuivre : un seul relais couvre toute une base. Pense à la protéger : une antenne cassée, c'est toute une zone sans réseau. Et casser celles de l'ennemi le prive de téléphone.", "", "À faire avant (sinon la quête ne se valide pas) : « Antenne en fer »."]
	quest.65DD0296B92B90EE.title: "Serveur du réseau"
	quest.65DD0296B92B90EE.quest_desc: ["Mécanisme de précision au centre. Protégé par un mot de passe : déverrouille-le et reste à côté pour gérer tes réseaux depuis un seul endroit. Joueurs autorisés et leurs rôles, forfaits d'appels et de messages (illimités par défaut, renouvelés chaque jour du jeu), numéros personnalisés (1 à 9 chiffres). Une antenne gérée par un serveur ne se règle plus au tournevis.", "", "À faire avant (sinon la quête ne se valide pas) : « Antenne en fer », « Mécanisme de précision » (chapitre « III · L'âge du laiton »)."]
	quest.4CD21757914C44B3.title: "Routeur Wi-Fi"
	quest.4CD21757914C44B3.quest_desc: ["Un point d'accès Internet local, pour les applications du téléphone qui ont besoin de données (Gram pour les photos, Plans pour la carte et les lieux). Il lui faut une puce de fournisseur Wi-Fi, qui ne se fabrique pas : au bloc Serveur (déverrouillé), onglet Networks, lie ton réseau au serveur (Link) ; puis onglet Wi-Fi, choisis ce réseau comme fournisseur principal (Primary provider) du joueur et clique sur Issue. La puce arrive dans ton inventaire (garde une case libre). Mets-la dans le routeur, donne un nom et un mot de passe au Wi-Fi, puis Save. Seuls son propriétaire et les joueurs autorisés peuvent l'ouvrir.", "", "À faire avant (sinon la quête ne se valide pas) : « Serveur du réseau »."]
	chapter.2A2265D026036A84.title: "Vie de camp · Prisonniers"
	chapter.2A2265D026036A84.chapter_subtitle: ["Cuffed : menotter un ennemi, le fouiller, l'enfermer. Et verrouiller ses coffres."]
	quest.4419B332E26A6282.title: "Menottes"
	quest.4419B332E26A6282.quest_desc: ["Clic droit sur un joueur en visant ses bras. Sur ce serveur, il doit avoir moins de 30 % de sa vie. Menotté, il ne peut plus miner, utiliser d'objets ni ouvrir son inventaire. Il peut tenter de s'en libérer : les menottes s'usent à chaque essai."]
	quest.3845E110B565AE9C.title: "Clé de menottes"
	quest.3845E110B565AE9C.quest_desc: ["La seule façon d'enlever des menottes (ou des entraves de chevilles) proprement. L'infobulle de chaque entrave indique sa clé.", "", "À faire avant (sinon la quête ne se valide pas) : « Menottes »."]
	quest.6682E7B0AEA6AA86.title: "Fers"
	quest.6682E7B0AEA6AA86.quest_desc: ["Plus faibles que les menottes : le prisonnier ne mine plus, mais garde ses objets et son inventaire. S'enlèvent avec la clé de fers. Le ruban adhésif, lui, bâillonne ou attache bras et jambes.", "", "À faire avant (sinon la quête ne se valide pas) : « Menottes »."]
	quest.0F9306F09DF08CDC.title: "Escorter un prisonnier"
	quest.0F9306F09DF08CDC.quest_desc: ["Accroupi + clic droit sur un joueur entravé : il te suit. Clic droit sur un siège ou une entité (monture, wagon) pour l'y installer de force. Accroupis-toi pour arrêter. Une chaîne attache un joueur ou un animal à toi, puis à une barrière ou une ancre lestée. Coche la quête quand tu as escorté quelqu'un.", "", "À faire avant (sinon la quête ne se valide pas) : « Menottes »."]
	quest.7D500C79F613130A.title: "Loupe de fouille"
	quest.7D500C79F613130A.quest_desc: ["Maintiens « utiliser » sur un joueur entravé : son inventaire s'affiche. Maintiens le clic gauche 2 secondes sur un emplacement pour lui prendre l'objet (ou lui en poser un).", "", "À faire avant (sinon la quête ne se valide pas) : « Menottes »."]
	quest.45C07B5E219AB266.title: "Boîte de confiscation"
	quest.45C07B5E219AB266.quest_desc: ["Utilise une boîte vide sur un joueur pour le fouiller, puis choisis les objets à ranger dedans. La boîte pleine se garde comme un sac.", "", "À faire avant (sinon la quête ne se valide pas) : « Loupe de fouille »."]
	quest.73DAF296B6488B9B.title: "Crochets de serrure"
	quest.73DAF296B6488B9B.quest_desc: ["Clic droit sur un cadenas, une porte de cellule ou un joueur menotté : un test d'adresse commence, appuie au bon moment. Réussi, le verrou cède ; raté, le crochet peut casser. Utile pour libérer un coéquipier.", "", "À faire avant (sinon la quête ne se valide pas) : « Menottes »."]
	quest.2053229138EB583E.title: "Clé"
	quest.2053229138EB583E.quest_desc: ["Une clé neuve n'est liée à rien : utilise-la sur un cadenas ou une porte de cellule pour la lier. Ensuite, elle seule ouvre et ferme ce verrou."]
	quest.12FBD3E3917282F4.title: "Cadenas"
	quest.12FBD3E3917282F4.quest_desc: ["Se pose sur n'importe quel bloc (coffre, porte, machine) et bloque TOUTE utilisation. Lie-lui une clé pour le verrouiller. Un diamant sur le cadenas le renforce : il résiste mieux aux crochets.", "", "À faire avant (sinon la quête ne se valide pas) : « Clé »."]
	quest.57DA5CD50D952D7C.title: "Trousseau et copies"
	quest.57DA5CD50D952D7C.quest_desc: ["Trousseau : deux clés ou plus dans la grille d'artisanat (recette spéciale, absente de JEI), pour tout ouvrir avec un seul objet. Copie : clé liée + boule d'argile à l'établi = moule à clé, cuit au four, puis moule cuit + lingot de fer = copie de la clé. Le moule s'use en quelques copies.", "", "À faire avant (sinon la quête ne se valide pas) : « Clé »."]
	quest.76BABC9DD46C9421.title: "Coffre-fort"
	quest.76BABC9DD46C9421.quest_desc: ["Bloc de fer et cadenas. Un rangement à clé, qui se crochète difficilement.", "", "À faire avant (sinon la quête ne se valide pas) : « Cadenas »."]
	quest.3528F05AAB15E52A.title: "Pierre renforcée"
	quest.3528F05AAB15E52A.quest_desc: ["4 lingots d'acier et 5 pierres pour 4 blocs. Très longue à miner, et résiste aux bombes Mk 82 et Mk 84 comme l'obsidienne : de quoi bâtir une prison ou un abri. Existe en pierre lisse, dalles, escaliers, barreaux et lampe.", "", "À faire avant (sinon la quête ne se valide pas) : « Acier » (chapitre « IV · L'âge de l'acier »)."]
	quest.20D9AA511845F544.title: "Porte de cellule"
	quest.20D9AA511845F544.quest_desc: ["Barreaux renforcés et acier. Se verrouille avec une clé, ne se casse qu'à la pioche.", "", "À faire avant (sinon la quête ne se valide pas) : « Pierre renforcée », « Clé »."]
	quest.2BA0363BDAE79C5B.title: "Couchette"
	quest.2BA0363BDAE79C5B.quest_desc: ["Un lit renforcé : on y fixe son point d'apparition, et il ne se casse qu'à la pioche.", "", "À faire avant (sinon la quête ne se valide pas) : « Pierre renforcée »."]
	quest.6564830D7A2A2331.title: "Pilori"
	quest.6564830D7A2A2331.quest_desc: ["Place un joueur devant et utilise le pilori : il est enfermé, sans pouvoir bouger ni utiliser quoi que ce soit, jusqu'à ce qu'on le libère. Un joueur aux bras entravés ne peut pas y être mis.", "", "À faire avant (sinon la quête ne se valide pas) : « Menottes »."]
	quest.510D2E1A2D4B2034.title: "Guillotine"
	quest.510D2E1A2D4B2034.quest_desc: ["Posée au-dessus d'un pilori occupé, un clic l'actionne. Un second clic la réarme. Le prisonnier y laisse sa tête.", "", "À faire avant (sinon la quête ne se valide pas) : « Pilori »."]
	quest.1289F49D8D1C1779.title: "Matricule de prisonnier"
	quest.1289F49D8D1C1779.quest_desc: ["Renomme-le à l'enclume, puis utilise-le sur un joueur : il porte ce surnom. Un matricule sans nom efface le surnom.", "", "À faire avant (sinon la quête ne se valide pas) : « Menottes »."]
}
