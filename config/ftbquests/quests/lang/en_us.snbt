	quest.1EE57FF7AC1CE23E.title: "Roulement d'hélice"
	quest.1EE57FF7AC1CE23E.quest_desc: ["Monte une hélice.", "", "À faire avant (sinon la quête ne se valide pas) : « Assembleur physique »."]
