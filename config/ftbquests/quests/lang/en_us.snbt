	quest.3518B5471B7B5FB7.title: "Lévitite"
	quest.3518B5471B7B5FB7.quest_desc: ["Bloc qui flotte : cœur des engins volants.", "", "À faire avant (sinon la quête ne se valide pas) : « Assembleur physique »."]
	quest.05FDA2B82A2AD1A8.title: "Roulement gyroscopique"
	quest.05FDA2B82A2AD1A8.quest_desc: ["Stabilise ton appareil.", "", "À faire avant (sinon la quête ne se valide pas) : « Hélice intelligente »."]
	quest.272A653ABDC4AEA8.title: "Lunettes d'aviateur"
	quest.272A653ABDC4AEA8.quest_desc: ["Le style avant tout.", "", "À faire avant (sinon la quête ne se valide pas) : « Hélice en bois »."]
	quest.7C20E95A942D4C67.title: "Propulseur"
	quest.7C20E95A942D4C67.quest_desc: ["Propulsion à carburant liquide. Boîtier et pompes en acier.", "", "À faire avant (sinon la quête ne se valide pas) : « Hélice intelligente », « Acier » (chapitre « IV · L'âge de l'acier »)."]
	quest.2CAF69BC04CF5457.title: "Ailes"
	quest.2CAF69BC04CF5457.quest_desc: ["Portance pour les vrais avions.", "", "À faire avant (sinon la quête ne se valide pas) : « Propulseur »."]
	quest.64BB7E9FFD6811F8.title: "Jetpack"
	quest.64BB7E9FFD6811F8.quest_desc: ["Fonctionne à l'air comprimé.", "", "À faire avant (sinon la quête ne se valide pas) : « Mécanisme de précision » (chapitre « III · L'âge du laiton »)."]
	quest.63E37FB26871FA09.title: "Canon de compression"
	quest.63E37FB26871FA09.quest_desc: ["Rétrécit ou agrandit un engin (de 1/4 à 4 fois sur ce serveur). Fonctionne au mélange de lévitite.", "", "À faire avant (sinon la quête ne se valide pas) : « Lévitite »."]
	quest.49338B93783AEC0F.title: "Toolgun de survie"
	quest.49338B93783AEC0F.quest_desc: ["Appuie sur Tab : enregistre ton engin en plan, soude deux engins entre eux, tourne-les ou déplace-les au bloc près.", "", "À faire avant (sinon la quête ne se valide pas) : « Assembleur physique »."]
	quest.3BB58D9C82C97AFD.title: "Pistolet magnétique"
	quest.3BB58D9C82C97AFD.quest_desc: ["Attrape un engin à 24 blocs, déplace-le à la molette, et lance-le d'un clic gauche.", "", "À faire avant (sinon la quête ne se valide pas) : « Toolgun de survie »."]
	quest.18CC370C232D7295.title: "Conteneur de structure"
	quest.18CC370C232D7295.quest_desc: ["Range un engin entier dans ton inventaire (clic droit maintenu), et repose-le ailleurs.", "", "À faire avant (sinon la quête ne se valide pas) : « Toolgun de survie »."]
	quest.09B94D1F8CAE0A56.title: "Tiges pneumatiques"
	quest.09B94D1F8CAE0A56.quest_desc: ["Vérins réglables entre deux engins : trains d'atterrissage, suspensions, bras articulés.", "", "À faire avant (sinon la quête ne se valide pas) : « Assembleur physique »."]
