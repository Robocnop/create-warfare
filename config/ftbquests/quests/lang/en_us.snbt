	quest.03501335E22DFE6C.quest_desc: ["Combustible des réacteurs New Age."]
	quest.32582178B42BF6F2.title: "Barres de réacteur New Age"
	quest.32582178B42BF6F2.quest_desc: ["Second type de réacteur."]
	chapter.47DA1C59EB2CE985.title: "Missiles \\& radar"
	chapter.47DA1C59EB2CE985.chapter_subtitle: ["Détecter, suivre et frapper à longue distance."]
	quest.77E3E4D638A041C4.title: "Jumelles"
	quest.77E3E4D638A041C4.quest_desc: ["Repérage et désignation de cibles."]
	quest.764793E12A209AEB.title: "Roulement de radar"
	quest.764793E12A209AEB.quest_desc: ["Base du radar rotatif."]
	quest.2B6DCB051C43594F.title: "Antenne radar"
	quest.2B6DCB051C43594F.quest_desc: ["Détecte avions et navires."]
	quest.39F9BD3B7CF5FEEF.title: "Écran radar"
	quest.39F9BD3B7CF5FEEF.quest_desc: ["Affiche les contacts."]
	quest.69A8DDF795F0DA59.title: "Conduite de tir"
	quest.69A8DDF795F0DA59.quest_desc: ["Relie radar et canons."]
	quest.3E0317F5F0964CCF.title: "Transpondeur IFF"
	quest.3E0317F5F0964CCF.quest_desc: ["Ami ou ennemi ?"]
	quest.27B565817BA421AC.title: "Radar d'avion"
	quest.27B565817BA421AC.quest_desc: ["Radar compact à embarquer sur tes appareils."]
	quest.58B19C6FE111E7F3.title: "AIM-9 Sidewinder"
	quest.58B19C6FE111E7F3.quest_desc: ["Missile air-air guidé."]
	quest.33AAAE60BA29B4DD.title: "Patriot"
	quest.33AAAE60BA29B4DD.quest_desc: ["Défense antimissile."]
	quest.68B6E8B7239C1A49.title: "Tomahawk"
	quest.68B6E8B7239C1A49.quest_desc: ["Missile de croisière longue portée : demande des Codes de lancement."]
	quest.31F9D5BE8608A54A.title: "Pas de tir (Create Missiles)"
	quest.31F9D5BE8608A54A.quest_desc: ["Missiles physiques modulaires. Les pièces demandent de l'acier."]
	quest.183A1FBA2348EB6B.title: "Ogive (Create Missiles)"
	quest.183A1FBA2348EB6B.quest_desc: ["La charge utile. Les ogives destructrices demandent des obus HE."]
	chapter.41960E5E13891BC1.title: "Armes de destruction massive"
	chapter.41960E5E13891BC1.chapter_subtitle: ["La fin de partie : bombes lourdes et ICBM nucléaires. Avec modération..."]
	quest.74D2A1F364AADF7C.title: "Établi de munitions"
	quest.74D2A1F364AADF7C.quest_desc: ["Assemble bombes, ogives et missiles. Se fabrique avec de l'acier et des mécanismes."]
	quest.4B2F05AFDAF2B237.title: "Bombe Mk 82"
	quest.4B2F05AFDAF2B237.quest_desc: ["Bombe d'aviation légère."]
	quest.282FEA33AE7FE437.title: "Bombe Mk 84"
	quest.282FEA33AE7FE437.quest_desc: ["Bombe d'aviation lourde."]
	quest.0E1A85CD7654EC56.title: "Appel de frappe aérienne"
	quest.0E1A85CD7654EC56.quest_desc: ["Cinq Mk 82 sur la cible."]
	quest.66775A330665F94C.title: "Lunettes anti-flash"
	quest.66775A330665F94C.quest_desc: ["Pour regarder le champignon sans devenir aveugle."]
	quest.2AD09B2F01C16648.title: "Compteur Geiger"
	quest.2AD09B2F01C16648.quest_desc: ["Mesure les retombées."]
	quest.4F02DCB64718598B.title: "Lingots d'uranium"
	quest.4F02DCB64718598B.quest_desc: ["Matière fissile : 4 yellowcakes enrichis et du plomb, compactés sous brûleur surchauffé."]
	quest.6A4B67DC521A8EBE.title: "Système de visée"
	quest.6A4B67DC521A8EBE.quest_desc: ["Longue-vue, boussole et redstone : désigne la cible de l'ICBM."]
	quest.624917B0AC01463C.title: "Codes de lancement"
	quest.624917B0AC01463C.quest_desc: ["Indispensables pour armer un ICBM (tenus en main secondaire à la pose) et pour les missiles longue portée. Quête répétable : les objets sont consommés, une fois par équipe, puis délai de 4 h."]
	quest.5CF5DE993A303811.title: "ICBM léger"
	quest.5CF5DE993A303811.quest_desc: ["Premier missile balistique. Sa pose consomme des Codes de lancement."]
	quest.14F3D1B8E9E9E22F.title: "ICBM lourd"
	quest.14F3D1B8E9E9E22F.quest_desc: ["Plus gros, plus loin."]
	quest.5FC9A9FB2250304D.title: "Fat Man"
	quest.5FC9A9FB2250304D.quest_desc: ["La bombe nucléaire larguée."]
	quest.5CD90A2B6E78FBBB.title: "ICBM nucléaire"
	quest.5CD90A2B6E78FBBB.quest_desc: ["L'arme ultime. Le serveur s'en souviendra."]
	chapter.16A7BFA622EEA61D.title: "Défense \\& informatique"
	chapter.16A7BFA622EEA61D.chapter_subtitle: ["Ordinateurs pour piloter canons et avions, et une base qui se défend toute seule."]
	quest.51DA5E89D7D3F671.title: "Ordinateur"
	quest.51DA5E89D7D3F671.quest_desc: ["CC: Tweaked, avec des recettes passées par Create. Il pilote trains, gares et boîtes de vitesses séquencées."]
	quest.3635CA2A9238EDD0.title: "Modems filaires"
	quest.3635CA2A9238EDD0.quest_desc: ["Relie l'ordinateur aux machines voisines (périphériques)."]
	quest.2F62A39BF6AD3800.title: "Moniteurs avancés"
	quest.2F62A39BF6AD3800.quest_desc: ["Un grand écran couleur pour tes tableaux de bord."]
	quest.3341112053D99015.title: "Canon piloté par ordinateur"
	quest.3341112053D99015.quest_desc: ["Avec CC:CBC, un ordinateur relié par modem à un affût de canon le vise et le fait tirer. Branche-le sur ton radar : la DCA devient automatique."]
	quest.12AE20BF3CF08536.title: "Avionique"
	quest.12AE20BF3CF08536.quest_desc: ["Avec Create: Avionics, un ordinateur embarqué lit et commande les blocs Aeronautics (cap, altitude, hélices). Pilote automatique compris."]
	quest.6F8358FC1FA5F25A.title: "Tortue"
	quest.6F8358FC1FA5F25A.quest_desc: ["Un petit robot programmable : il mine, construit et transporte."]
	quest.2C4721D77E50AA98.title: "Blocs laser"
	quest.2C4721D77E50AA98.quest_desc: ["Premier pas de SecurityCraft : une barrière invisible qui déclenche tes défenses."]
	quest.44F24B414E0DD228.title: "Renforceur universel"
	quest.44F24B414E0DD228.quest_desc: ["Transforme tes blocs en blocs renforcés que seuls toi et ton équipe pouvez casser. Les obus CBC, Superb Warfare et la TNT les abîment, mais les bombes et ICBM de Project: Explosive n'y font rien : parfait pour un bunker anti-nucléaire."]
	quest.6EFD5A18CB66C8A0.title: "Murs renforcés"
	quest.6EFD5A18CB66C8A0.quest_desc: ["Les murs de ta base, ou de ton bunker : ils encaissent Fat Man et les ICBM, pas l'artillerie."]
	quest.14BDCFD95D3B0B6A.title: "Clavier à code"
	quest.14BDCFD95D3B0B6A.quest_desc: ["Ferme une porte ou un coffre avec un code."]
	quest.6DD8CD9DA47BBC02.title: "Caméras de sécurité"
	quest.6DD8CD9DA47BBC02.quest_desc: ["Surveille ta base à distance avec un écran de caméras."]
	quest.12BE8EA035108910.title: "Mines"
	quest.12BE8EA035108910.quest_desc: ["Pour les invités qui n'ont pas sonné."]
	quest.1813381F944EDFE5.title: "Radar portatif"
	quest.1813381F944EDFE5.quest_desc: ["Signale les joueurs qui approchent."]
	quest.053E2AB78B4CDD5A.title: "Tourelle"
	quest.053E2AB78B4CDD5A.quest_desc: ["Tire sur les intrus. Demande de l'acier et des tubes électroniques."]
	quest.3500B9C3283A3465.title: "Système Trophy"
	quest.3500B9C3283A3465.quest_desc: ["Abat les projectiles qui approchent. Demande des circuits imprimés TFMG."]
	chapter.5C329C6DE6204446.title: "Cuisine"
	chapter.5C329C6DE6204446.chapter_subtitle: ["Kaleidoscope Cookery : cuisiner pour tenir entre deux batailles. Son moulin accepte aussi le moulin de Create."]
	quest.286285B15331B404.title: "Fourneau"
	quest.286285B15331B404.quest_desc: ["La base de la cuisine : pose un wok ou une marmite dessus."]
	quest.1FA1339164ED206D.title: "Couteau de cuisine"
	quest.1FA1339164ED206D.quest_desc: ["Pour découper sur la planche."]
	quest.6718BE632F527AA2.title: "Planche à découper"
	quest.6718BE632F527AA2.quest_desc: ["Découpe viandes et légumes."]
	quest.21A65A2702955B75.title: "Wok"
	quest.21A65A2702955B75.quest_desc: ["Sauté rapide sur le fourneau, avec la spatule."]
	quest.60135E9F91129E15.title: "Marmite"
	quest.60135E9F91129E15.quest_desc: ["Soupes et ragoûts mijotés."]
	quest.6D5225B21A033C13.title: "Nouvelles graines"
	quest.6D5225B21A033C13.quest_desc: ["Tomates, piments, laitue et riz. Le chapeau de paille fait tomber des graines des herbes."]
	quest.3A4B453B4ACF67F8.title: "Riz cuit"
	quest.3A4B453B4ACF67F8.quest_desc: ["La base des bols de riz."]
	quest.4370E6FB8E8803A0.title: "Moulin"
	quest.4370E6FB8E8803A0.quest_desc: ["Farine, huile et riz décortiqué. Le moulin de Create fait aussi ses recettes."]
	quest.473344BEB37CC400.title: "Œufs au plat"
	quest.473344BEB37CC400.quest_desc: ["Premier plat au wok."]
	quest.40815A7E1BB832A8.title: "Bol de bœuf braisé"
	quest.40815A7E1BB832A8.quest_desc: ["Un vrai repas de soldat."]
	quest.36D2FAFFBDEE0624.title: "Cuiseur vapeur"
	quest.36D2FAFFBDEE0624.quest_desc: ["Brioches et raviolis à la vapeur."]
	chapter.57C2176FB3D9A403.title: "Espace (Northstar)"
	chapter.57C2176FB3D9A403.chapter_subtitle: ["Titane, circuits et fusées : la Lune, puis Mars, Mercure et Vénus."]
	quest.6D5B291D9D5DCA92.title: "Télescope"
	quest.6D5B291D9D5DCA92.quest_desc: ["Laiton, éclat d'améthyste et bâtons. La nuit, clic droit avec du papier : tu obtiens un relevé astronomique de la planète visée."]
	quest.504DE8797372588C.title: "Concentré de rutile"
	quest.504DE8797372588C.quest_desc: ["Le minerai de titane de la Terre. Le broyeur en tire du sable (25 %) ou du calcaire (50 %, par deux)."]
	quest.413BD90157D70A23.title: "Sel"
	quest.413BD90157D70A23.quest_desc: ["Basalte broyé : 2 à 4 sels."]
	quest.6E57D9D4BB97984D.title: "Catalyseur au sodium"
	quest.6E57D9D4BB97984D.quest_desc: ["Un sel arrosé de lave par un bec verseur."]
	quest.0A89AE921FF3784A.title: "Tétrachlorure de titane"
	quest.0A89AE921FF3784A.quest_desc: ["Mélangeur sur brûleur surchauffé : 3 rutiles, 1 catalyseur, 1 zinc et du carbone liquide (3 charbons compactés sur brûleur allumé)."]
	quest.15142AF3BCA06E7A.title: "Titane"
	quest.15142AF3BCA06E7A.quest_desc: ["Séquence sur une plaque robuste de Create : lave, presse, tétrachlorure, presse, eau. La fonte liquide de CBC peut remplacer la lave. Hors de la Terre, le minerai de titane se fond directement."]
	quest.1CAB18184BA3CF04.title: "Atlas spatial"
	quest.1CAB18184BA3CF04.quest_desc: ["Un livre et un lingot de titane. Il garde les planètes découvertes et les balises, et se pose dans la station de fusée pour choisir la destination."]
	quest.73B4EFF5859488E3.title: "Table d'astronomie"
	quest.73B4EFF5859488E3.quest_desc: ["Atlas + relevés astronomiques = science. Assez de science débloque une planète. Les relevés de planètes différentes rapportent plus ; un seul relevé par planète et par jour."]
	quest.4B915DCCDD665D2A.title: "Cristal d'améthyste"
	quest.4B915DCCDD665D2A.quest_desc: ["Améthystes polies au papier de verre, redstone et fer. Le cœur du graveur de circuits."]
	quest.14A3C6ECD05A512F.title: "Graveur de circuits"
	quest.14A3C6ECD05A512F.quest_desc: ["Fabricants mécaniques : titane, quartz rose poli, mécanisme de précision et cristal d'améthyste. Il fait l'étape de gravure des circuits."]
	quest.3E8548C11299A4CC.title: "Circuits"
	quest.3E8548C11299A4CC.quest_desc: ["Séquence sur une plaque de fer : améthyste polie, plaque de cuivre, plaque d'or, puis gravure. Il en faut partout."]
	quest.6A5EC12FB6CCB26A.title: "Mécanisme de précision durci"
	quest.6A5EC12FB6CCB26A.quest_desc: ["Séquence sur un mécanisme de précision : pépite de titane, roue dentée en fer, grande roue dentée en fer (arbre + bloc de fer industriel)."]
	quest.71C8BC723873506B.title: "Ordinateur de visée"
	quest.71C8BC723873506B.quest_desc: ["Séquence sur une plaque de fer : diamant poli (au papier de verre), mécanisme durci, gravure, circuit, gravure."]
	quest.08317F95AFF3791C.title: "Séparateur d'oxygène"
	quest.08317F95AFF3791C.quest_desc: ["Plaques de fer, tube électronique et tuyaux."]
	quest.2F64312ED1A8F692.title: "Concentrateur atmosphérique"
	quest.2F64312ED1A8F692.quest_desc: ["Récupère l'oxygène (ou le carbone) de l'air. La première source d'oxygène, avant l'électrolyse."]
	quest.64D3BB42E011CA4E.title: "Combinaison spatiale"
	quest.64D3BB42E011CA4E.quest_desc: ["Armure en fer + tissu résistant + plaques de fer ; le plastron contient une citerne dorsale en cuivre. Fais aussi le casque (verre teinté), les jambières et les bottes."]
	quest.0C3659764E5D4D51.title: "Remplisseur d'oxygène"
	quest.0C3659764E5D4D51.quest_desc: ["Pompe de l'oxygène dedans, puis clic droit avec la combinaison : il la remplit. Sans oxygène, on meurt vite hors de la Terre."]
	quest.6BFE111144953C41.title: "Chambre de combustion"
	quest.6BFE111144953C41.quest_desc: ["Titane, séparateur d'oxygène, mécanisme durci et hélice."]
	quest.599A5BD6A4315027.title: "Propulseurs de fusée"
	quest.599A5BD6A4315027.quest_desc: ["Le nombre nécessaire dépend du poids de la fusée et de la gravité des deux planètes : la station de fusée te le dit."]
	quest.7765641F001D0799.title: "Commandes de fusée"
	quest.7765641F001D0799.quest_desc: ["Le poste de pilotage. Fixe-le à la fusée avec de la super colle, sinon l'assemblage échoue."]
	quest.70B87AA0A32DC1F0.title: "Station de fusée"
	quest.70B87AA0A32DC1F0.quest_desc: ["Assemble la fusée construite au-dessus. Pose l'atlas dedans pour choisir la destination ; elle affiche le carburant, les propulseurs et le bouclier thermique qui manquent."]
	quest.7B6D4A7934E9A892.title: "Un petit pas"
	quest.7B6D4A7934E9A892.quest_desc: ["Carburant dans des réservoirs de fluides à bord (liste dans JEI depuis la station ; la quantité dépend de la gravité et de la distance), blocs de métal pour le bouclier thermique, combinaison remplie. Assemble, monte aux commandes, saute pour lancer. Rapporte de la pierre lunaire."]
	quest.35A1510FB9FC9A56.title: "Saphir lunaire"
	quest.35A1510FB9FC9A56.quest_desc: ["Dans les géodes de la Lune. Poli au papier de verre, il sert au navigateur et aux circuits avancés."]
	quest.273651B7469170DB.title: "Baie informatique"
	quest.273651B7469170DB.quest_desc: ["Des ordinateurs de visée rangés dans des baies à bord réduisent la consommation de carburant."]
	quest.6FBE4298438CCADF.title: "Navigateur interplanétaire"
	quest.6FBE4298438CCADF.quest_desc: ["Saphirs lunaires polis, circuits, titane et un ordinateur de visée. La station indique les voyages où il est obligatoire."]
	quest.4A696EE8826569F3.title: "Acier martien"
	quest.4A696EE8826569F3.quest_desc: ["Sur Mars : fer martien brut + cendre volcanique + titane, compactés sur brûleur allumé, donnent 2 lingots."]
	quest.59C889F6DEC55A50.title: "Combinaison en acier martien"
	quest.59C889F6DEC55A50.quest_desc: ["Même recette que la combinaison en fer, avec l'armure et les plaques d'acier martien."]
	quest.55C75DE1801B0C73.title: "Machine d'électrolyse"
	quest.55C75DE1801B0C73.quest_desc: ["L'eau devient hydrogène et oxygène ; la saumure (sel + eau) donne chlore et sodium."]
	quest.7637C9C1D3F05A33.title: "Scelleur d'oxygène"
	quest.7637C9C1D3F05A33.quest_desc: ["Oxygène par l'arrière, rotation par le dessous : il remplit d'air une base fermée. Le grand ventilateur en titane agrandit la zone."]
	quest.4F38F22EE2169CA2.title: "Circuit avancé"
	quest.4F38F22EE2169CA2.quest_desc: ["Séquence sur un circuit : saphir lunaire poli, plaque d'acier martien, plaque d'or, gravure."]
	quest.5CCA89FBA8469754.title: "Régulateur de température"
	quest.5CCA89FBA8469754.quest_desc: ["Glace bleue, bâtons de blaze et circuits avancés : rend vivable une base sur Mercure ou Vénus."]
	quest.1BF6E5A1A579303C.title: "Tungstène"
	quest.1BF6E5A1A579303C.quest_desc: ["Sur Mercure. Le minerai broyé puis lavé donne 9 pépites."]
	quest.72402A23BE04B03D.title: "Balise de fusée"
	quest.72402A23BE04B03D.quest_desc: ["Clic droit dessus avec l'atlas : la fusée pourra atterrir exactement à cet endroit."]
	quest.6CECD95D21D3333B.title: "Station d'atterrissage automatique"
	quest.6CECD95D21D3333B.quest_desc: ["Fait atterrir la fusée sans danger, sans pilote."]
	quest.5FF44D51B7519262.title: "Panneau solaire"
	quest.5FF44D51B7519262.quest_desc: ["Verre teinté, titane et circuit sur un arbre : de la rotation tirée du soleil."]
}
