	quest.2FFA65C3E7BB3247.title: "Viseur de canon"
	quest.2FFA65C3E7BB3247.quest_desc: ["CBC Optics : un viseur posé sur le canon, pour viser à travers lui.", "", "À faire avant (sinon la quête ne se valide pas) : « Affût »."]
	quest.091EF9309D9F4800.title: "Calculateur balistique"
	quest.091EF9309D9F4800.quest_desc: ["CBC Ballistics : donne-lui la position du canon et celle de la cible, il calcule l'angle de tir.", "", "À faire avant (sinon la quête ne se valide pas) : « Affût », « Mécanisme de précision » (chapitre « III · L'âge du laiton »)."]
	quest.4FBBF5C4723F0E09.title: "Charges de poudre"
	quest.4FBBF5C4723F0E09.quest_desc: ["Propulsent l'obus.", "", "À faire avant (sinon la quête ne se valide pas) : « Four à coke » (chapitre « IV · L'âge de l'acier »)."]
	quest.3F12664295876503.title: "Obus explosifs"
	quest.3F12664295876503.quest_desc: ["Ne pas utiliser à côté de ta base.", "", "À faire avant (sinon la quête ne se valide pas) : « Charges de poudre »."]
	quest.6392648C2449FD82.title: "Obus perforants"
	quest.6392648C2449FD82.quest_desc: ["Contre les blindages.", "", "À faire avant (sinon la quête ne se valide pas) : « Charges de poudre »."]
	quest.0FEBAEFB7397AEEA.title: "Fusées d'impact"
	quest.0FEBAEFB7397AEEA.quest_desc: ["Détonation au contact.", "", "À faire avant (sinon la quête ne se valide pas) : « Obus explosifs »."]
	quest.373FA88363AF5418.title: "Autocanon"
	quest.373FA88363AF5418.quest_desc: ["Tir rapide antiaérien.", "", "À faire avant (sinon la quête ne se valide pas) : « Affût »."]
	quest.7D6CDDC817019BF8.title: "Munitions flak"
	quest.7D6CDDC817019BF8.quest_desc: ["Pour descendre les avions.", "", "À faire avant (sinon la quête ne se valide pas) : « Autocanon »."]
