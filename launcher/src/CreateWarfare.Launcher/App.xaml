<Application x:Class="CreateWarfare.Launcher.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- Design system : Themes/Tokens.xaml (tailles, icônes), Themes/Palettes/*.xaml (couleurs du thème,
             remplacée par ThemeManager), Themes/Controls.xaml (composants). -->
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Palettes/Default.xaml" />
                <ResourceDictionary Source="Themes/Tokens.xaml" />
                <ResourceDictionary Source="Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Compatibilité de l'ancienne fenêtre (lot 1) -->
            <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource LinkButton}">
                <Setter Property="FontFamily" Value="{StaticResource Mono}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,0,16,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
