<Window x:Class="CreateWarfare.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:CreateWarfare.Launcher.ViewModels"
        xmlns:c="clr-namespace:CreateWarfare.Launcher.Controls"
        xmlns:ui="clr-namespace:CreateWarfare.Launcher.Themes"
        Title="Create Warfare" Icon="Assets/icon.ico" Width="1180" Height="720" MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" FontFamily="{StaticResource Sans}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>
    <Window.Resources>
        <!-- Apparition d'une page : fondu court (coupé si Windows demande moins d'animations) -->
        <Style x:Key="Page" TargetType="FrameworkElement">
            <Style.Triggers>
                <Trigger Property="IsVisible" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard><DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="{x:Static ui:Motion.Base}" /></Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- En-tête de page : bouton Retour + surtitre + titre -->
        <Style x:Key="PageHeader" TargetType="DockPanel">
            <Setter Property="Margin" Value="0,0,0,24" />
            <Setter Property="LastChildFill" Value="True" />
        </Style>
        <!-- Ligne de paramètre : libellé et explication à gauche, contrôle à droite -->
        <Style x:Key="SettingRow" TargetType="DockPanel">
            <Setter Property="Margin" Value="0,0,0,22" />
            <Setter Property="LastChildFill" Value="True" />
        </Style>
        <!-- Pastille d'état du serveur -->
        <Style x:Key="StatusDot" TargetType="Ellipse">
            <Setter Property="Width" Value="9" />
            <Setter Property="Height" Value="9" />
            <Setter Property="Fill" Value="{DynamicResource Dim}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ServerState}" Value="online"><Setter Property="Fill" Value="{DynamicResource Success}" /></DataTrigger>
                <DataTrigger Binding="{Binding ServerState}" Value="offline"><Setter Property="Fill" Value="{DynamicResource Error}" /></DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="46" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===================== Barre de titre (déplaçable) ===================== -->
        <Border Grid.ColumnSpan="2" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                    <TextBlock Text="{StaticResource IcSettings}" FontFamily="{StaticResource Icons}" FontSize="17" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" />
                    <TextBlock FontFamily="{DynamicResource Display}" FontSize="19" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0,0,0">
                        <Run Text="CREATE" /> <Run Text="WARFARE" Foreground="{DynamicResource Accent}" />
                    </TextBlock>
                    <Border Style="{StaticResource Badge}" Margin="14,0,0,0">
                        <TextBlock Style="{StaticResource BadgeText}" Text="{Binding LauncherVersion}" />
                    </Border>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource CaptionButton}" Content="{StaticResource IcMinimize}" Click="OnMinimize" ToolTip="{DynamicResource t.001}" />
                    <Button Style="{StaticResource CaptionButton}" x:Name="MaxButton" Content="{StaticResource IcMaximize}" Click="OnMaximize" ToolTip="{DynamicResource t.002}" />
                    <Button Style="{StaticResource CloseButton}" Content="{StaticResource IcClose}" Click="OnClose" ToolTip="{DynamicResource t.003}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===================== Onglets (en haut, comme le launcher officiel) ===================== -->
        <Border Grid.Row="1" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
            <DockPanel IsEnabled="{Binding NavEnabled}">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,12,0" VerticalAlignment="Center">
                    <Button Style="{StaticResource IconButton}" Content="{StaticResource IcCode}" Command="{Binding OpenLinkCommand}" CommandParameter="{Binding GithubUrl}" ToolTip="{DynamicResource t.004}" HorizontalAlignment="Center" Margin="2,0" />
                    <Button Style="{StaticResource IconButton}" Content="{StaticResource IcPeople}" Command="{Binding OpenLinkCommand}" CommandParameter="{Binding DiscordUrl}" ToolTip="Discord" HorizontalAlignment="Center" Margin="2,0" Visibility="{Binding HasDiscord, Converter={StaticResource Vis}}" />
                    <Button Style="{StaticResource IconButton}" Content="{StaticResource IcGlobe}" Command="{Binding OpenLinkCommand}" CommandParameter="{Binding WebsiteUrl}" ToolTip="{DynamicResource t.005}" HorizontalAlignment="Center" Margin="2,0" Visibility="{Binding HasWebsite, Converter={StaticResource Vis}}" />
                    <Button Style="{StaticResource IconButton}" Content="{StaticResource IcBug}" Command="{Binding ReportBugCommand}" ToolTip="{DynamicResource t.006}" HorizontalAlignment="Center" Margin="2,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <RadioButton Style="{StaticResource NavTab}" GroupName="nav" Content="{DynamicResource t.007}" ui:Ui.Icon="{StaticResource IcHome}" IsChecked="{Binding NavHome, Mode=TwoWay}" ToolTip="{DynamicResource t.008}" />
                    <RadioButton Style="{StaticResource NavTab}" GroupName="nav" Content="{DynamicResource t.009}" ui:Ui.Icon="{StaticResource IcNews}" IsChecked="{Binding NavNews, Mode=TwoWay}" ToolTip="{DynamicResource t.010}" />
                    <RadioButton Style="{StaticResource NavTab}" GroupName="nav" Content="{DynamicResource t.011}" ui:Ui.Icon="{StaticResource IcGallery}" IsChecked="{Binding NavGallery, Mode=TwoWay}" ToolTip="{DynamicResource t.012}" />
                    <RadioButton Style="{StaticResource NavTab}" GroupName="nav" Content="{DynamicResource t.013}" ui:Ui.Icon="{StaticResource IcSettings}" IsChecked="{Binding NavSettings, Mode=TwoWay}" ToolTip="{DynamicResource t.014}" />
                    <RadioButton Style="{StaticResource NavTab}" GroupName="nav" Content="Logs" ui:Ui.Icon="{StaticResource IcLogs}" IsChecked="{Binding NavLogs, Mode=TwoWay}" ToolTip="{DynamicResource t.015}" />
                    <RadioButton Style="{StaticResource NavTab}" GroupName="nav" Content="{DynamicResource t.016}" ui:Ui.Icon="{StaticResource IcInfo}" IsChecked="{Binding NavAbout, Mode=TwoWay}" ToolTip="{DynamicResource t.017}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===================== Contenu ===================== -->
        <Grid Grid.Row="2" ClipToBounds="True">

            <!-- ============ ACCUEIL ============ -->
            <Grid Style="{StaticResource Page}" Visibility="{Binding IsHome, Converter={StaticResource Vis}}">
                <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <c:Carousel x:Name="HomeCarousel" Grid.RowSpan="2" Images="{Binding HomeSlides}" Index="{Binding SlideIndex, Mode=TwoWay}" IsPaused="{Binding CarouselPaused}" />
                <!-- Voiles : lisibilité du texte sur l'image -->
                <Rectangle IsHitTestVisible="False" Grid.RowSpan="2">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="{DynamicResource BgColor}" Offset="0" />
                            <GradientStop Color="#990E1014" Offset="0.45" />
                            <GradientStop Color="#330E1014" Offset="0.62" />
                            <GradientStop Color="#B30E1014" Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Rectangle IsHitTestVisible="False" VerticalAlignment="Bottom" Height="260">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#000E1014" Offset="0" />
                            <GradientStop Color="{DynamicResource BgColor}" Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <!-- Décor d'ambiance du thème (neige, pétales…) : au-dessus des images, sous le contenu -->
                <c:AmbientLayer Grid.RowSpan="2" />

                <Grid Margin="44,32,32,28">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="380" />
                    </Grid.ColumnDefinitions>

                    <!-- Gauche : annonce, titre, légende de l'image, indicateurs -->
                    <DockPanel Grid.Column="0" Margin="0,0,32,0" LastChildFill="False">
                        <Border DockPanel.Dock="Top" Style="{StaticResource GlassCard}" Padding="16,12" HorizontalAlignment="Left" MaxWidth="520"
                                Visibility="{Binding HasNotice, Converter={StaticResource Vis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{StaticResource IcNews}" FontFamily="{StaticResource Icons}" Foreground="{DynamicResource Accent}" FontSize="16" VerticalAlignment="Top" Margin="0,2,12,0" />
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Kicker}" Text="{DynamicResource t.018}" Foreground="{DynamicResource Accent}" />
                                    <TextBlock Text="{Binding Notice}" FontSize="14" TextWrapping="Wrap" MaxWidth="460" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <StackPanel DockPanel.Dock="Bottom">
                            <TextBlock Style="{StaticResource Kicker}" Text="{DynamicResource t.019}" Foreground="{DynamicResource Accent}" />
                            <TextBlock FontFamily="{DynamicResource Display}" FontSize="{StaticResource FontHero}" FontWeight="Bold" LineHeight="58" LineStackingStrategy="BlockLineHeight">
                                <Run Text="CREATE" /><LineBreak /><Run Text="WARFARE" Foreground="{DynamicResource Accent}" />
                            </TextBlock>
                            <TextBlock Text="{Binding SlideCaption}" Style="{StaticResource Body}" Foreground="{DynamicResource Text}" FontSize="{StaticResource FontBodyLarge}"
                                       MaxWidth="520" HorizontalAlignment="Left" Margin="0,10,0,18" />
                            <!-- Pause au survol de cette ligne seulement : le défilement continue ailleurs -->
                            <StackPanel Orientation="Horizontal" Visibility="{Binding HasSlides, Converter={StaticResource Vis}}" Background="Transparent"
                                        MouseEnter="OnCarouselHover" MouseLeave="OnCarouselLeave">
                            <StackPanel Orientation="Horizontal" Visibility="{Binding ShowSlideNav, Converter={StaticResource Vis}}">
                                <Button Style="{StaticResource IconButton}" Content="{StaticResource IcChevronLeft}" Command="{Binding PrevSlideCommand}" ToolTip="{DynamicResource t.020}" />
                                <ItemsControl ItemsSource="{Binding SlideDots}" VerticalAlignment="Center" Margin="6,0">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:SlideDot}">
                                            <Button Command="{Binding Go}" Cursor="Hand" Focusable="False" ToolTip="{DynamicResource t.021}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="Transparent" Padding="4,8">
                                                            <Border x:Name="dot" Width="8" Height="8" CornerRadius="4" Background="{DynamicResource LineStrong}" />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                <Setter TargetName="dot" Property="Width" Value="22" />
                                                                <Setter TargetName="dot" Property="Background" Value="{DynamicResource Accent}" />
                                                            </DataTrigger>
                                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="dot" Property="Background" Value="{DynamicResource Text}" /></Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Style="{StaticResource IconButton}" Content="{StaticResource IcChevronRight}" Command="{Binding NextSlideCommand}" ToolTip="{DynamicResource t.022}" />
                            </StackPanel>
                                <!-- Bouton discret : images du serveur ou illustration du thème (choix sauvegardé) -->
                                <Button Style="{StaticResource IconButton}" Content="{StaticResource IcPalette}" Command="{Binding ToggleHomePhotosCommand}" Opacity="0.55" Margin="10,0,0,0"
                                        ToolTip="{DynamicResource s.home.photosOff}" AutomationProperties.Name="{DynamicResource s.home.photosOff}"
                                        Visibility="{Binding HomePhotos, Converter={StaticResource Vis}}" />
                                <Button Style="{StaticResource IconButton}" Content="{StaticResource IcGallery}" Command="{Binding ToggleHomePhotosCommand}" Opacity="0.55"
                                        ToolTip="{DynamicResource s.home.photosOn}" AutomationProperties.Name="{DynamicResource s.home.photosOn}"
                                        Visibility="{Binding HomePhotos, Converter={StaticResource Vis}, ConverterParameter=invert}" />
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>

                    <!-- Droite : serveur, dernière mise à jour, lancement -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Bottom">
                        <!-- Serveur -->
                        <Border Style="{StaticResource GlassCard}" Padding="18,14" Margin="0,0,0,12">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="{StaticResource IcRefresh}" Command="{Binding RefreshServerCommand}"
                                        ToolTip="{DynamicResource t.023}" VerticalAlignment="Center" />
                                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="{StaticResource IcCopy}" Command="{Binding CopyAddressCommand}"
                                        ToolTip="{DynamicResource t.024}" VerticalAlignment="Center" />
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Style="{StaticResource StatusDot}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding ServerName}" FontWeight="SemiBold" FontSize="14" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding ServerAddress}" FontFamily="{StaticResource Mono}" FontSize="12" Foreground="{DynamicResource Muted}" Margin="17,3,0,0" />
                                    <StackPanel Orientation="Horizontal" Margin="17,6,0,0">
                                        <TextBlock Text="{Binding ServerLine}" FontSize="12.5" Foreground="{DynamicResource Text}" />
                                        <TextBlock Text="{Binding ServerPingText}" FontFamily="{StaticResource Mono}" FontSize="12" Foreground="{DynamicResource Dim}" Margin="10,0,0,0" />
                                    </StackPanel>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- Dernière mise à jour -->
                        <Button Command="{Binding NavCommand}" CommandParameter="news" Cursor="Hand" Margin="0,0,0,12" ToolTip="{DynamicResource t.025}"
                                FocusVisualStyle="{StaticResource FocusRing}" Visibility="{Binding HasLatest, Converter={StaticResource Vis}}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="card" Style="{StaticResource GlassCard}" Padding="18,14">
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{StaticResource IcChevronRight}" FontFamily="{StaticResource Icons}" FontSize="12" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />
                                                <TextBlock Style="{StaticResource Kicker}" Margin="0">
                                                    <Run Text="{DynamicResource t.026}" /><Run Text="{Binding LatestDate, Mode=OneWay}" />
                                                </TextBlock>
                                            </DockPanel>
                                            <TextBlock Text="{Binding LatestTitle}" FontFamily="{DynamicResource Display}" FontSize="22" FontWeight="Bold" Margin="0,4,0,4" />
                                            <TextBlock Text="{Binding LatestLines}" FontSize="12.5" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" LineHeight="19" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="card" Property="BorderBrush" Value="{DynamicResource Accent}" /></Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Pack de textures recommandé (PureBDcraft : lien seulement, jamais téléchargé par le launcher) -->
                        <Border Style="{StaticResource GlassCard}" Padding="18,14">
                            <StackPanel>
                                <DockPanel>
                                    <Border DockPanel.Dock="Right" Style="{StaticResource Badge}" VerticalAlignment="Top" Visibility="{Binding BdcraftInstalled, Converter={StaticResource Vis}}">
                                        <TextBlock Style="{StaticResource BadgeText}" Text="{DynamicResource s.bd.installed}" Foreground="{DynamicResource Success}" />
                                    </Border>
                                    <Border DockPanel.Dock="Right" Style="{StaticResource Badge}" VerticalAlignment="Top" Visibility="{Binding BdcraftMissing, Converter={StaticResource Vis}}">
                                        <TextBlock Style="{StaticResource BadgeText}" Text="{DynamicResource s.bd.missing}" Foreground="{DynamicResource Warning}" />
                                    </Border>
                                    <TextBlock Style="{StaticResource Kicker}" Text="{DynamicResource s.bd.kicker}" Margin="0" VerticalAlignment="Center" />
                                </DockPanel>
                                <TextBlock Text="{DynamicResource s.bd.title}" FontFamily="{DynamicResource Display}" FontSize="20" FontWeight="Bold" Margin="0,4,0,4" />
                                <TextBlock Text="{DynamicResource s.bd.text}" FontSize="12" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" LineHeight="17" />
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Style="{StaticResource LinkButton}" Content="{DynamicResource s.bd.download}" ui:Ui.Icon="{StaticResource IcGlobe}"
                                            Command="{Binding OpenLinkCommand}" CommandParameter="{Binding BdcraftUrl}" />
                                    <Button Style="{StaticResource LinkButton}" Content="{DynamicResource s.bd.openFolder}" ui:Ui.Icon="{StaticResource IcFolder}" Margin="16,0,0,0"
                                            Command="{Binding OpenResourcePacksCommand}" Visibility="{Binding HasInstance, Converter={StaticResource Vis}}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Barre de lancement (comme le launcher officiel) : version à gauche, gros bouton JOUER au centre, outils à droite -->
                <Border Grid.Row="1" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="28,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Left">
                            <TextBlock Style="{StaticResource Kicker}" Text="{Binding StatusTitle}" Foreground="{DynamicResource Accent}" Margin="0,0,0,2" />
                            <TextBlock FontSize="13">
                                <Run Text="{DynamicResource t.028}" Foreground="{DynamicResource Muted}" /><Run Text="{Binding PackVersion, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="  ·  " Foreground="{DynamicResource Dim}" /><Run Text="{Binding PackSub, Mode=OneWay}" Foreground="{DynamicResource Muted}" />
                            </TextBlock>
                            <TextBlock FontSize="12" Margin="0,4,0,0" Foreground="{DynamicResource Muted}" Text="{DynamicResource s.launch.viaCf}" />
                                <!-- Sélecteur de canal (stable / pré-release) : affiché seulement s'il y a un choix à faire (mode développeur) -->
                                <Grid Margin="0,8,0,0" Width="250" HorizontalAlignment="Left" Visibility="{Binding HasVersionChoice, Converter={StaticResource Vis}}">
                                    <ToggleButton x:Name="VersionToggle" IsChecked="{Binding IsVersionMenuOpen, Mode=TwoWay}" Cursor="Hand" ToolTip="{DynamicResource t.029}"
                                                  FocusVisualStyle="{StaticResource FocusRing}">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border x:Name="Box" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource LineStrong}" BorderThickness="1"
                                                        CornerRadius="{StaticResource RadiusM}" Padding="12,8">
                                                    <DockPanel>
                                                        <TextBlock DockPanel.Dock="Right" x:Name="Chevron" Text="{StaticResource IcChevronDown}" FontFamily="{StaticResource Icons}" FontSize="11"
                                                                   Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />
                                                        <ContentPresenter />
                                                    </DockPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Muted}" /></Trigger>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                                        <Setter TargetName="Chevron" Property="Text" Value="{StaticResource IcChevronUp}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                        <StackPanel Orientation="Horizontal">
                                            <Grid Width="26" Height="26" VerticalAlignment="Center">
                                                <Grid.RowDefinitions><RowDefinition Height="8" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                                <Border Grid.RowSpan="2" Background="#79553A" CornerRadius="3" />
                                                <Border Grid.Row="0" Background="#5DA130" CornerRadius="3,3,0,0" Visibility="{Binding ChoiceIsRelease, Converter={StaticResource Vis}}" />
                                            </Grid>
                                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ChoiceLabel}" FontWeight="SemiBold" FontSize="13.5" />
                                                <TextBlock Text="{Binding ChoiceVersion}" FontFamily="{StaticResource Mono}" FontSize="11.5" Foreground="{DynamicResource Muted}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </ToggleButton>
                                    <Popup IsOpen="{Binding IsVersionMenuOpen, Mode=TwoWay}" PlacementTarget="{Binding ElementName=VersionToggle}" Placement="Top"
                                           StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" Width="{Binding ActualWidth, ElementName=VersionToggle}">
                                        <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource LineStrong}" BorderThickness="1" CornerRadius="{StaticResource RadiusM}"
                                                Margin="0,0,0,4" Padding="4">
                                            <ItemsControl ItemsSource="{Binding VersionItems}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Command="{Binding SelectCommand}" Cursor="Hand">
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="Item" Background="Transparent" Padding="10,8" CornerRadius="{StaticResource RadiusS}"><ContentPresenter /></Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Item" Property="Background" Value="{DynamicResource Hover}" /></Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="13.5" />
                                                                <TextBlock Text="{Binding Version}" FontFamily="{StaticResource Mono}" FontSize="11.5" Foreground="{DynamicResource Muted}" />
                                                            </StackPanel>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Border>
                                    </Popup>
                                </Grid>

                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Button Style="{StaticResource PrimaryButton}" Content="{Binding PrimaryText}" Command="{Binding PrimaryCommand}" ui:Ui.Icon="{Binding PrimaryIcon}"
                                    ui:Ui.IsBusy="{Binding IsLaunching}" ToolTip="{Binding PlayHint}" Width="360" Height="60" FontSize="20" x:Name="PlayButton" />
                            <TextBlock Text="{Binding PlayHint}" Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,6,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Style="{StaticResource Kicker}" Text="LAUNCHER" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <Button Style="{StaticResource LinkButton}" Content="{Binding LauncherSub}" Command="{Binding UpdateLauncherCommand}" Foreground="{DynamicResource Warning}"
                                        ui:Ui.Icon="{StaticResource IcDownload}" ToolTip="{DynamicResource t.027}" Visibility="{Binding LauncherUpdateAvailable, Converter={StaticResource Vis}}" />
                                <TextBlock Text="{Binding LauncherSub}" FontSize="12" Foreground="{DynamicResource Success}" VerticalAlignment="Center"
                                           Visibility="{Binding LauncherUpToDate, Converter={StaticResource Vis}}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                <Button Style="{StaticResource LinkButton}" Content="{DynamicResource t.030}" ui:Ui.Icon="{StaticResource IcRepair}" Command="{Binding RepairCommand}"
                                        ToolTip="{DynamicResource t.031}" Visibility="{Binding HasInstance, Converter={StaticResource Vis}}" />
                                <Button Style="{StaticResource LinkButton}" Content="{DynamicResource t.032}" ui:Ui.Icon="{StaticResource IcFolder}" Command="{Binding OpenInstanceCommand}"
                                        ToolTip="{DynamicResource t.033}" Margin="16,0,0,0" Visibility="{Binding HasInstance, Converter={StaticResource Vis}}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- ============ PREMIÈRE INSTALLATION ============ -->
            <ScrollViewer Style="{StaticResource Page}" VerticalScrollBarVisibility="Auto" Visibility="{Binding IsInstall, Converter={StaticResource Vis}}">
                <StackPanel Margin="{StaticResource PadPage}" MaxWidth="720" HorizontalAlignment="Left">
                    <DockPanel Style="{StaticResource PageHeader}">
                        <Button DockPanel.Dock="Left" Style="{StaticResource IconButton}" Content="{StaticResource IcBack}" Command="{Binding GoBackCommand}" ToolTip="{DynamicResource t.034}" Margin="0,0,14,0" VerticalAlignment="Center" />
                        <StackPanel>
                            <TextBlock Style="{StaticResource Kicker}" Text="{DynamicResource t.035}" Foreground="{DynamicResource Accent}" />
                            <TextBlock Style="{StaticResource Title}" Text="{DynamicResource t.036}" />
                        </StackPanel>
                    </DockPanel>
                    <TextBlock Style="{StaticResource Body}" Margin="0,0,0,24" Text="{DynamicResource t.037}" />

                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource BigNumber}" FontSize="30" Text="1" Foreground="{DynamicResource Accent}" Width="44" />
                            <StackPanel>
                                <TextBlock Style="{StaticResource H3}" Text="{DynamicResource t.038}" />
                                <TextBlock Style="{StaticResource Body}" Text="{DynamicResource t.039}" Margin="0,2,0,12" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource SecondaryButton}" Content="{DynamicResource t.040}" ui:Ui.Icon="{StaticResource IcDownload}" Command="{Binding DownloadZipCommand}" />
                                    <Button Style="{StaticResource LinkButton}" Content="{DynamicResource t.041}" Command="{Binding ShowZipCommand}" Margin="16,0,0,0" VerticalAlignment="Center"
                                            Visibility="{Binding HasInstallZip, Converter={StaticResource Vis}}" />
                                </StackPanel>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource BigNumber}" FontSize="30" Text="2" Foreground="{DynamicResource Accent}" Width="44" />
                            <StackPanel>
                                <TextBlock Style="{StaticResource H3}" Text="{DynamicResource t.042}" />
                                <TextBlock Style="{StaticResource Body}" Margin="0,2,0,12"
                                           Text="{DynamicResource t.043}" />
                                <Button Style="{StaticResource SecondaryButton}" Content="{DynamicResource t.044}" ui:Ui.Icon="{StaticResource IcOpen}" Command="{Binding OpenCurseForgeCommand}" HorizontalAlignment="Left" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,24">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource BigNumber}" FontSize="30" Text="3" Foreground="{DynamicResource Accent}" Width="44" />
                            <StackPanel>
                                <TextBlock Style="{StaticResource H3}" Text="{DynamicResource t.045}" />
                                <TextBlock Style="{StaticResource Body}" Text="{DynamicResource t.046}" Margin="0,2,0,0" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource PrimaryButton}" Content="{DynamicResource t.047}" ui:Ui.Icon="{StaticResource IcAccept}" Command="{Binding RescanCommand}" />
                        <Button Style="{StaticResource GhostButton}" Content="{DynamicResource t.048}" ui:Ui.Icon="{StaticResource IcFolder}" Command="{Binding BrowseCommand}" Margin="12,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- ============ TRAVAIL EN COURS ============ -->
            <Grid Style="{StaticResource Page}" Visibility="{Binding IsWorking, Converter={StaticResource Vis}}">
                <c:HeroArt ShowTitle="False" Opacity="0.35" />
                <Border Style="{StaticResource GlassCard}" Width="560" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="32,28">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Kicker}" Text="{Binding WorkKicker}" Foreground="{DynamicResource Accent}" />
                        <TextBlock Style="{StaticResource H2}" Text="{Binding WorkTitle}" Margin="0,0,0,20" />
                        <DockPanel Margin="0,0,0,10">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding WorkPercent, StringFormat={}{0} %}" FontFamily="{DynamicResource Display}" FontSize="26" FontWeight="Bold" VerticalAlignment="Bottom" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource BigNumber}" FontSize="36" Text="{Binding WorkCount}" />
                                <TextBlock Text="{Binding WorkTotal}" FontFamily="{StaticResource Mono}" FontSize="14" Foreground="{DynamicResource Muted}" VerticalAlignment="Bottom" Margin="10,0,0,8" />
                            </StackPanel>
                        </DockPanel>
                        <ProgressBar Minimum="0" Maximum="1" Value="{Binding WorkProgress, Mode=OneWay}" Height="8" />
                        <DockPanel Margin="0,10,0,0">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding WorkDetail}" FontFamily="{StaticResource Mono}" FontSize="12" Foreground="{DynamicResource Text}" />
                            <TextBlock Text="{Binding WorkCurrent}" FontFamily="{StaticResource Mono}" FontSize="12" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
                        </DockPanel>
                        <Button Style="{StaticResource SecondaryButton}" Content="{DynamicResource t.049}" ui:Ui.Icon="{StaticResource IcCancel}" Command="{Binding CancelWorkCommand}" HorizontalAlignment="Left" Margin="0,22,0,0"
                                Visibility="{Binding CanCancel, Converter={StaticResource Vis}}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ============ REVUE DE LA MISE À JOUR ============ -->
            <DockPanel Style="{StaticResource Page}" Margin="{StaticResource PadPage}" Visibility="{Binding IsReview, Converter={StaticResource Vis}}">
                <DockPanel DockPanel.Dock="Top" Style="{StaticResource PageHeader}">
                    <Button DockPanel.Dock="Left" Style="{StaticResource IconButton}" Content="{StaticResource IcBack}" Command="{Binding GoBackCommand}" ToolTip="{DynamicResource t.050}" Margin="0,0,14,0" VerticalAlignment="Center" />
                    <StackPanel>
                        <TextBlock Style="{StaticResource Kicker}" Text="{Binding ReviewKicker}" Foreground="{DynamicResource Accent}" />
                        <TextBlock Style="{StaticResource Title}" Text="{Binding ReviewTitle}" />
                    </StackPanel>
                </DockPanel>
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Body}" Text="{Binding ReviewText}" Margin="0,0,0,16" MaxWidth="760" HorizontalAlignment="Left" />
                <UniformGrid DockPanel.Dock="Top" Rows="1" Margin="0,0,0,16">
                    <UniformGrid.Resources>
                        <Style TargetType="Border" BasedOn="{StaticResource Card}"><Setter Property="Margin" Value="0,0,10,0" /><Setter Property="Padding" Value="14,10" /></Style>
                    </UniformGrid.Resources>
                    <Border><StackPanel><TextBlock Style="{StaticResource BigNumber}" FontSize="24" Text="{Binding CountReplace}" /><TextBlock Style="{StaticResource Caption}" Text="{DynamicResource t.051}" /></StackPanel></Border>
                    <Border><StackPanel><TextBlock Style="{StaticResource BigNumber}" FontSize="24" Text="{Binding CountAdd}" Foreground="{DynamicResource Success}" /><TextBlock Style="{StaticResource Caption}" Text="{DynamicResource t.052}" /></StackPanel></Border>
                    <Border><StackPanel><TextBlock Style="{StaticResource BigNumber}" FontSize="24" Text="{Binding CountRemove}" Foreground="{DynamicResource Error}" /><TextBlock Style="{StaticResource Caption}" Text="{DynamicResource t.053}" /></StackPanel></Border>
                    <Border><StackPanel><TextBlock Style="{StaticResource BigNumber}" FontSize="24" Text="{Binding CountSame}" Foreground="{DynamicResource Muted}" /><TextBlock Style="{StaticResource Caption}" Text="{DynamicResource t.054}" /></StackPanel></Border>
                    <Border><StackPanel><TextBlock Style="{StaticResource BigNumber}" FontSize="24" Text="{Binding CountKept}" Foreground="{DynamicResource Warning}" /><TextBlock Style="{StaticResource Caption}" Text="{DynamicResource s.review.kept}" /></StackPanel></Border>
                    <Border Margin="0"><StackPanel><TextBlock Style="{StaticResource BigNumber}" FontSize="24" Text="{Binding CountProtected}" Foreground="{DynamicResource Warning}" /><TextBlock Style="{StaticResource Caption}" Text="{DynamicResource t.055}" /></StackPanel></Border>
                </UniformGrid>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,16,0,0">
                    <Button Style="{StaticResource PrimaryButton}" Content="{Binding ConfirmText}" ui:Ui.Icon="{StaticResource IcAccept}" Command="{Binding ConfirmCommand}" MinWidth="200" />
                    <Button Style="{StaticResource SecondaryButton}" Content="{DynamicResource t.049}" Command="{Binding BackHomeCommand}" Height="56" Margin="12,0,0,0" />
                </StackPanel>
                <Border Style="{StaticResource Card}" Padding="0">
                    <ListBox ItemsSource="{Binding Rows}" Background="Transparent" BorderThickness="0" Focusable="False" Margin="4"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Focusable" Value="False" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="12,7"><ContentPresenter /></Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:PlanRow}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock x:Name="icon" Text="{Binding Icon}" FontFamily="{StaticResource Mono}" FontSize="14" Foreground="{DynamicResource Muted}" />
                                    <TextBlock x:Name="path" Grid.Column="1" Text="{Binding Path}" FontFamily="{StaticResource Mono}" FontSize="12.5" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Text="{Binding Size}" FontFamily="{StaticResource Mono}" FontSize="12" Foreground="{DynamicResource Dim}" Margin="16,0,0,0" />
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Changes}" Value="True">
                                        <Setter TargetName="path" Property="Foreground" Value="{DynamicResource Text}" />
                                        <Setter TargetName="icon" Property="Foreground" Value="{DynamicResource Text}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="Remove"><Setter TargetName="icon" Property="Foreground" Value="{DynamicResource Error}" /></DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="Add"><Setter TargetName="icon" Property="Foreground" Value="{DynamicResource Success}" /></DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="Protected"><Setter TargetName="icon" Property="Foreground" Value="{DynamicResource Warning}" /></DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </DockPanel>

            <!-- ============ ACTUALITÉS ============ -->
            <DockPanel Style="{StaticResource Page}" Visibility="{Binding IsNews, Converter={StaticResource Vis}}">
                <DockPanel DockPanel.Dock="Top" Style="{StaticResource PageHeader}" Margin="40,32,40,20">
                    <Button DockPanel.Dock="Left" Style="{StaticResource IconButton}" Content="{StaticResource IcBack}" Command="{Binding GoBackCommand}" ToolTip="{DynamicResource t.056}" Margin="0,0,14,0" VerticalAlignment="Center" />
                    <StackPanel>
                        <TextBlock Style="{StaticResource Kicker}" Text="{DynamicResource t.057}" Foreground="{DynamicResource Accent}" />
                        <TextBlock Style="{StaticResource Title}" Text="{DynamicResource t.058}" />
                    </StackPanel>
                </DockPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="40,0,40,32" MaxWidth="900" HorizontalAlignment="Left">
                        <TextBlock Style="{StaticResource Body}" Text="{DynamicResource t.059}" Visibility="{Binding HasNews, Converter={StaticResource Vis}, ConverterParameter=invert}" />
                        <ItemsControl ItemsSource="{Binding NewsCards}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:NewsCard}">
                                    <Border Style="{StaticResource Card}" Margin="0,0,0,14" Padding="0">
                                        <StackPanel>
                                            <Image Source="{Binding Image}" Height="180" Stretch="UniformToFill" x:Name="img" />
                                            <StackPanel Margin="22,18,22,18">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                    <Border Style="{StaticResource Badge}" Margin="0,0,10,0"><TextBlock Style="{StaticResource BadgeText}" Text="{Binding Kicker}" /></Border>
                                                    <Border x:Name="tag" Style="{StaticResource Badge}" Background="{DynamicResource SurfaceHi}" Margin="0,0,10,0">
                                                        <TextBlock Style="{StaticResource BadgeText}" Foreground="{DynamicResource Text}" Text="{Binding Tag}" />
                                                    </Border>
                                                    <TextBlock Text="{Binding Date}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding Title}" Style="{StaticResource H2}" />
                                                <TextBlock x:Name="body" Text="{Binding Body}" Style="{StaticResource Body}" Margin="0,6,0,0" />
                                                <ItemsControl ItemsSource="{Binding Lines}" Margin="0,8,0,0">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type vm:NewsLine}">
                                                            <DockPanel Margin="0,6,0,0">
                                                                <Border DockPanel.Dock="Left" x:Name="cat" CornerRadius="{StaticResource RadiusPill}" Padding="8,1" Width="78" Margin="0,1,12,0" VerticalAlignment="Top"
                                                                        Background="{DynamicResource AccentSoft}">
                                                                    <TextBlock x:Name="catText" Text="{Binding CategoryLabel}" FontFamily="{StaticResource Mono}" FontSize="11" FontWeight="SemiBold"
                                                                               HorizontalAlignment="Center" Foreground="{DynamicResource Accent}" />
                                                                </Border>
                                                                <TextBlock TextWrapping="Wrap" FontSize="13.5" LineHeight="20" Foreground="{DynamicResource Muted}">
                                                                    <Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource Text}" /><Run Text=" " /><Run Text="{Binding Text, Mode=OneWay}" />
                                                                </TextBlock>
                                                            </DockPanel>
                                                            <DataTemplate.Triggers>
                                                                <DataTrigger Binding="{Binding Category}" Value="added"><Setter TargetName="catText" Property="Foreground" Value="{DynamicResource Success}" /></DataTrigger>
                                                                <DataTrigger Binding="{Binding Category}" Value="fixed"><Setter TargetName="catText" Property="Foreground" Value="{DynamicResource Info}" /></DataTrigger>
                                                                <DataTrigger Binding="{Binding Category}" Value="removed"><Setter TargetName="catText" Property="Foreground" Value="{DynamicResource Error}" /></DataTrigger>
                                                            </DataTemplate.Triggers>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Image}" Value="{x:Null}"><Setter TargetName="img" Property="Visibility" Value="Collapsed" /></DataTrigger>
                                        <DataTrigger Binding="{Binding Tag}" Value=""><Setter TargetName="tag" Property="Visibility" Value="Collapsed" /></DataTrigger>
                                        <DataTrigger Binding="{Binding Body}" Value=""><Setter TargetName="body" Property="Visibility" Value="Collapsed" /></DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>

            <!-- ============ GALERIE ============ -->
            <DockPanel Style="{StaticResource Page}" Visibility="{Binding IsGallery, Converter={StaticResource Vis}}">
                <DockPanel DockPanel.Dock="Top" Style="{StaticResource PageHeader}" Margin="40,32,40,20">
                    <Button DockPanel.Dock="Left" Style="{StaticResource IconButton}" Content="{StaticResource IcBack}" Command="{Binding GoBackCommand}" ToolTip="{DynamicResource t.056}" Margin="0,0,14,0" VerticalAlignment="Center" />
                    <StackPanel>
                        <TextBlock Style="{StaticResource Kicker}" Text="{DynamicResource t.060}" Foreground="{DynamicResource Accent}" />
                        <TextBlock Style="{StaticResource Title}" Text="{DynamicResource t.061}" />
                    </StackPanel>
                </DockPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="40,0,40,32">
                        <Border Style="{StaticResource Card}" HorizontalAlignment="Left" MaxWidth="640" Visibility="{Binding HasGallery, Converter={StaticResource Vis}, ConverterParameter=invert}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource H3}" Text="{DynamicResource t.062}" />
                                <TextBlock Style="{StaticResource Body}" Margin="0,4,0,0" Text="{DynamicResource t.063}" />
                            </StackPanel>
                        </Border>
                        <ItemsControl ItemsSource="{Binding GalleryCards}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:GalleryCard}">
                                    <Button Command="{Binding Open}" Cursor="Hand" Margin="0,0,12,12" ToolTip="{DynamicResource t.002}" FocusVisualStyle="{StaticResource FocusRing}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="frame" CornerRadius="{StaticResource RadiusL}" BorderBrush="{DynamicResource Line}" BorderThickness="1" ClipToBounds="True" Background="{DynamicResource Surface}">
                                                    <Grid>
                                                        <Image Source="{Binding Image}" Stretch="UniformToFill" Height="170" />
                                                        <Border VerticalAlignment="Bottom" Background="{DynamicResource Overlay}" Padding="12,8" x:Name="cap">
                                                            <TextBlock Text="{Binding Caption}" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="frame" Property="BorderBrush" Value="{DynamicResource Accent}" /></Trigger>
                                                    <DataTrigger Binding="{Binding Caption}" Value=""><Setter TargetName="cap" Property="Visibility" Value="Collapsed" /></DataTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>

            <!-- ============ PARAMÈTRES ============ -->
            <DockPanel Style="{StaticResource Page}" Visibility="{Binding IsSettings, Converter={StaticResource Vis}}">
                <StackPanel DockPanel.Dock="Top" Margin="40,32,40,0">
                    <DockPanel Style="{StaticResource PageHeader}" Margin="0,0,0,18">
                        <Button DockPanel.Dock="Left" Style="{StaticResource IconButton}" Content="{StaticResource IcBack}" Command="{Binding GoBackCommand}" ToolTip="{DynamicResource t.056}" Margin="0,0,14,0" VerticalAlignment="Center" />
                        <StackPanel>
                            <TextBlock Style="{StaticResource Kicker}" Text="{DynamicResource t.064}" Foreground="{DynamicResource Accent}" />
                            <TextBlock Style="{StaticResource Title}" Text="{DynamicResource t.065}" />
                        </StackPanel>
                    </DockPanel>
                    <Border Background="{DynamicResource Surface}" CornerRadius="{StaticResource RadiusM}" Padding="4" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource Segment}" GroupName="tabs" Content="{DynamicResource t.066}" ui:Ui.Icon="{StaticResource IcMemory}" IsChecked="{Binding TabGame, Mode=TwoWay}" />
                            <RadioButton Style="{StaticResource Segment}" GroupName="tabs" Content="{DynamicResource s.ap.tab}" ui:Ui.Icon="{StaticResource IcPalette}" IsChecked="{Binding TabAppearance, Mode=TwoWay}" />
                            <RadioButton Style="{StaticResource Segment}" GroupName="tabs" Content="{DynamicResource t.067}" ui:Ui.Icon="{StaticResource IcSettings}" IsChecked="{Binding TabLauncher, Mode=TwoWay}" />
                            <RadioButton Style="{StaticResource Segment}" GroupName="tabs" Content="{DynamicResource t.068}" ui:Ui.Icon="{StaticResource IcFolder}" IsChecked="{Binding TabInstance, Mode=TwoWay}" />
                            <RadioButton Style="{StaticResource Segment}" GroupName="tabs" Content="{DynamicResource t.069}" ui:Ui.Icon="{StaticResource IcRepair}" IsChecked="{Binding TabAdvanced, Mode=TwoWay}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="40,20,40,32" MaxWidth="820" HorizontalAlignment="Left">
                        <!-- Jeu -->
                        <StackPanel Visibility="{Binding TabGame, Converter={StaticResource Vis}}" VerticalAlignment="Top">
                        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Style="{StaticResource H3}" Text="{DynamicResource t.070}" />
                                <TextBlock Style="{StaticResource Body}" Text="{Binding RamAdvice}" Margin="0,4,0,4" />
                                <TextBlock Style="{StaticResource Caption}" Text="{Binding InstanceRam}" Margin="0,0,0,16" />
                                <DockPanel Margin="0,0,0,18">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding RamLabel}" FontFamily="{DynamicResource Display}" FontSize="24" FontWeight="Bold" Width="80" TextAlignment="Right" VerticalAlignment="Center" />
                                    <Slider Minimum="{Binding RamMin}" Maximum="{Binding RamMax}" Value="{Binding RamValue, Mode=TwoWay}" SmallChange="1024" LargeChange="1024"
                                            TickFrequency="1024" IsSnapToTickEnabled="True" VerticalAlignment="Center" ToolTip="{DynamicResource t.071}" />
                                </DockPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource PrimaryButton}" Content="{DynamicResource t.072}" ui:Ui.Icon="{StaticResource IcAccept}" Command="{Binding ApplyRamCommand}" Height="42"
                                            FontSize="16" Padding="18,0" ToolTip="{DynamicResource t.073}" />
                                    <Button Style="{StaticResource GhostButton}" Content="{DynamicResource t.074}" Command="{Binding ResetRamCommand}" Margin="8,0,0,0" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource Caption}" Margin="0,16,0,0"
                                           Text="{DynamicResource t.075}" />
                                <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding PerformanceMode}" Margin="0,24,0,0">
                                    <StackPanel><TextBlock Style="{StaticResource H3}" FontSize="15" Text="{DynamicResource s.perf.title}" /><TextBlock Style="{StaticResource Body}" Text="{DynamicResource s.perf.hint}" /></StackPanel>
                                </CheckBox>
                            </StackPanel>
                        </Border>
                        <!-- Lancement (2.0) : Jouer vérifie les fichiers puis CurseForge lance l'instance tout seul -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource H3}" Text="{DynamicResource s.set.launchTitle}" />
                                <TextBlock Style="{StaticResource Body}" Text="{DynamicResource s.set.launchHint}" Margin="0,4,0,12" />
                                <TextBlock Style="{StaticResource Caption}" Text="{DynamicResource s.set.launchNeeds}" TextWrapping="Wrap" Margin="0,0,0,16" />
                                <Button Style="{StaticResource SecondaryButton}" Content="{DynamicResource s.launch.openCf}" ui:Ui.Icon="{StaticResource IcOpen}"
                                        Command="{Binding OpenCurseForgeCommand}" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>
                        </StackPanel>

                        <!-- Apparence -->
                        <Border Style="{StaticResource Card}" Visibility="{Binding TabAppearance, Converter={StaticResource Vis}}" VerticalAlignment="Top">
                            <StackPanel>
                                <DockPanel Style="{StaticResource SettingRow}">
                                    <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding ThemeModeOptions}" SelectedItem="{Binding SelectedThemeMode, Mode=TwoWay}" DisplayMemberPath="Label" Width="260" />
                                    <StackPanel Margin="0,0,24,0"><TextBlock Style="{StaticResource H3}" FontSize="15" Text="{DynamicResource s.ap.mode}" /><TextBlock Style="{StaticResource Body}" Text="{DynamicResource t.077}" /></StackPanel>
                                </DockPanel>
                                <DockPanel Style="{StaticResource SettingRow}" Visibility="{Binding IsThemePick, Converter={StaticResource Vis}}">
                                    <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding SelectedTheme, Mode=TwoWay}" DisplayMemberPath="Label" Width="260" />
                                    <StackPanel Margin="0,0,24,0"><TextBlock Style="{StaticResource H3}" FontSize="15" Text="{DynamicResource t.076}" /><TextBlock Style="{StaticResource Body}" Text="{DynamicResource s.ap.pickHint}" /></StackPanel>
                                </DockPanel>
                                <TextBlock Style="{StaticResource H3}" FontSize="15" Text="{DynamicResource s.ap.preview}" />
                                <TextBlock Style="{StaticResource Body}" Text="{Binding ActiveThemeText}" Margin="0,2,0,12" />
                                <ItemsControl ItemsSource="{Binding ThemePreviews}" Margin="0,0,-10,22" Focusable="False">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding DataContext.PreviewThemeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding Key}"
                                                    ToolTip="{Binding Label}" AutomationProperties.Name="{Binding Label}" Margin="0,0,10,0" Cursor="Hand" FocusVisualStyle="{StaticResource FocusRing}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="b" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="2" CornerRadius="{StaticResource RadiusM}" Padding="2">
                                                            <StackPanel>
                                                                <c:HeroArt Theme="{Binding Key}" ShowTitle="False" Height="82" />
                                                                <DockPanel Margin="10,7,8,7">
                                                                    <TextBlock DockPanel.Dock="Right" Text="{StaticResource IcDone}" FontFamily="{StaticResource Icons}" FontSize="12" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"
                                                                               Visibility="{Binding IsActive, Converter={StaticResource Vis}}" />
                                                                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" Foreground="{DynamicResource Text}" TextTrimming="CharacterEllipsis" />
                                                                </DockPanel>
                                                            </StackPanel>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Muted}" /></Trigger>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}" /></DataTrigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding DecorAnimations}">
                                    <StackPanel><TextBlock Style="{StaticResource H3}" FontSize="15" Text="{DynamicResource s.ap.decor}" /><TextBlock Style="{StaticResource Body}" Text="{DynamicResource s.ap.decorHint}" /></StackPanel>
                                </CheckBox>
                            </StackPanel>
                        </Border>

                        <!-- Launcher -->
                        <Border Style="{StaticResource Card}" Visibility="{Binding TabLauncher, Converter={StaticResource Vis}}" VerticalAlignment="Top">
                            <StackPanel>
                                <DockPanel Style="{StaticResource SettingRow}">
                                    <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding LanguageOptions}" SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}" DisplayMemberPath="Label" Width="260" />
                                    <StackPanel Margin="0,0,24,0"><TextBlock Style="{StaticResource H3}" FontSize="15" Text="{DynamicResource t.078}" /><TextBlock Style="{StaticResource Body}" Text="{DynamicResource t.079}" /></StackPanel>
                                </DockPanel>
                                <DockPanel Style="{StaticResource SettingRow}">
                                    <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding GameLaunchOptions}" SelectedItem="{Binding SelectedGameLaunch, Mode=TwoWay}" DisplayMemberPath="Label" Width="260" />
                                    <StackPanel Margin="0,0,24,0"><TextBlock Style="{StaticResource H3}" FontSize="15" Text="{DynamicResource t.080}" /><TextBlock Style="{StaticResource Body}" Text="{DynamicResource t.081}" /></StackPanel>
                                </DockPanel>
                                <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding StartWithWindows}" Margin="0,0,0,18">
                                    <StackPanel><TextBlock Style="{StaticResource H3}" FontSize="15" Text="{DynamicResource t.082}" /><TextBlock Style="{StaticResource Body}" Text="{DynamicResource t.083}" /></StackPanel>
                                </CheckBox>
                                <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding AutoUpdateLauncher}" Margin="0,0,0,18">
                                    <StackPanel><TextBlock Style="{StaticResource H3}" FontSize="15" Text="{DynamicResource t.084}" /><TextBlock Style="{StaticResource Body}" Text="{DynamicResource t.085}" /></StackPanel>
                                </CheckBox>
                                <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding DevMode}">
                                    <StackPanel><TextBlock Style="{StaticResource H3}" FontSize="15" Text="{DynamicResource t.086}" /><TextBlock Style="{StaticResource Body}" Text="{DynamicResource t.087}" /></StackPanel>
                                </CheckBox>
                            </StackPanel>
                        </Border>

                        <!-- Instance -->
                        <Border Style="{StaticResource Card}" Visibility="{Binding TabInstance, Converter={StaticResource Vis}}" VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Style="{StaticResource H3}" Text="{DynamicResource t.088}" />
                                <TextBlock Style="{StaticResource Body}" Margin="0,4,0,14"
                                           Text="{DynamicResource t.089}" />
                                <Border Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="{StaticResource RadiusM}" Padding="14,10" Margin="0,0,0,14">
                                    <TextBlock Text="{Binding InstancePath}" FontFamily="{StaticResource Mono}" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                                </Border>
                                <WrapPanel>
                                    <Button Style="{StaticResource SecondaryButton}" Content="{DynamicResource t.090}" ui:Ui.Icon="{StaticResource IcFolder}" Command="{Binding BrowseCommand}" Margin="0,0,10,10" />
                                    <Button Style="{StaticResource SecondaryButton}" Content="{DynamicResource t.091}" ui:Ui.Icon="{StaticResource IcSync}" Command="{Binding AutoDetectCommand}" Margin="0,0,10,10" />
                                    <Button Style="{StaticResource SecondaryButton}" Content="{DynamicResource t.092}" ui:Ui.Icon="{StaticResource IcOpen}" Command="{Binding OpenInstanceCommand}" Margin="0,0,10,10" />
                                    <Button Style="{StaticResource SecondaryButton}" Content="{DynamicResource t.093}" ui:Ui.Icon="{StaticResource IcRepair}" Command="{Binding RepairCommand}" Margin="0,0,10,10" />
                                </WrapPanel>
                                <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0" Text="{DynamicResource t.094}" />
                            </StackPanel>
                        </Border>

                        <!-- Avancé -->
                        <StackPanel Visibility="{Binding TabAdvanced, Converter={StaticResource Vis}}" VerticalAlignment="Top">
                            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                                <StackPanel>
                                    <DockPanel Style="{StaticResource SettingRow}">
                                        <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="{DynamicResource t.095}" ui:Ui.Icon="{StaticResource IcDelete}" Command="{Binding ClearCacheCommand}" />
                                        <StackPanel Margin="0,0,24,0"><TextBlock Style="{StaticResource H3}" FontSize="15" Text="{DynamicResource t.096}" />
                                            <TextBlock Style="{StaticResource Body}"><Run Text="{DynamicResource t.097}" /><Run Text="{Binding CacheSize, Mode=OneWay}" Foreground="{DynamicResource Text}" /></TextBlock></StackPanel>
                                    </DockPanel>
                                    <DockPanel Style="{StaticResource SettingRow}">
                                        <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="{DynamicResource t.098}" ui:Ui.Icon="{StaticResource IcZip}" Command="{Binding ExportLogsCommand}" />
                                        <StackPanel Margin="0,0,24,0"><TextBlock Style="{StaticResource H3}" FontSize="15" Text="{DynamicResource t.099}" /><TextBlock Style="{StaticResource Body}" Text="{DynamicResource t.100}" /></StackPanel>
                                    </DockPanel>
                                    <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding DebugLog}" Margin="0,0,0,18">
                                        <StackPanel><TextBlock Style="{StaticResource H3}" FontSize="15" Text="{DynamicResource t.101}" /><TextBlock Style="{StaticResource Body}" Text="{DynamicResource t.102}" /></StackPanel>
                                    </CheckBox>
                                    <DockPanel Style="{StaticResource SettingRow}" Margin="0">
                                        <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="{DynamicResource t.103}" ui:Ui.Icon="{StaticResource IcRefresh}" Command="{Binding ResetSettingsCommand}" />
                                        <StackPanel Margin="0,0,24,0"><TextBlock Style="{StaticResource H3}" FontSize="15" Text="{DynamicResource t.104}" /><TextBlock Style="{StaticResource Body}" Text="{DynamicResource t.105}" /></StackPanel>
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" BorderBrush="{DynamicResource Error}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource H3}" Text="{DynamicResource t.106}" Foreground="{DynamicResource Error}" />
                                    <TextBlock Style="{StaticResource Body}" Text="{DynamicResource t.107}" Margin="0,4,0,12" />
                                    <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding KeepPlayerData}" Margin="0,0,0,14">
                                        <TextBlock Style="{StaticResource Body}" Foreground="{DynamicResource Text}"><Run Text="{DynamicResource t.108}" /><Run Text="{Binding BackupRoot, Mode=OneWay}" FontFamily="{StaticResource Mono}" FontSize="12" /><Run Text=")" /></TextBlock>
                                    </CheckBox>
                                    <Button Style="{StaticResource DangerButton}" Content="{DynamicResource t.109}" ui:Ui.Icon="{StaticResource IcDelete}" Command="{Binding UninstallCommand}" HorizontalAlignment="Left" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </DockPanel>

            <!-- ============ LOGS ============ -->
            <DockPanel Style="{StaticResource Page}" Margin="{StaticResource PadPage}" Visibility="{Binding IsLogs, Converter={StaticResource Vis}}">
                <DockPanel DockPanel.Dock="Top" Style="{StaticResource PageHeader}" Margin="0,0,0,16">
                    <Button DockPanel.Dock="Left" Style="{StaticResource IconButton}" Content="{StaticResource IcBack}" Command="{Binding GoBackCommand}" ToolTip="{DynamicResource t.056}" Margin="0,0,14,0" VerticalAlignment="Center" />
                    <StackPanel>
                        <TextBlock Style="{StaticResource Kicker}" Text="{DynamicResource t.110}" Foreground="{DynamicResource Accent}" />
                        <TextBlock Style="{StaticResource Title}" Text="{DynamicResource t.015}" />
                    </StackPanel>
                </DockPanel>
                <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                    <Button Style="{StaticResource SecondaryButton}" Content="{DynamicResource t.111}" ui:Ui.Icon="{StaticResource IcCopy}" Command="{Binding CopyLogsCommand}" Margin="0,0,10,0" ToolTip="{DynamicResource t.112}" />
                    <Button Style="{StaticResource SecondaryButton}" Content="{DynamicResource t.092}" ui:Ui.Icon="{StaticResource IcFolder}" Command="{Binding OpenLogsCommand}" Margin="0,0,10,0" />
                    <Button Style="{StaticResource SecondaryButton}" Content="{DynamicResource t.113}" ui:Ui.Icon="{StaticResource IcOpen}" Command="{Binding OpenGameLogsCommand}" Margin="0,0,10,0" ToolTip="{DynamicResource t.114}" />
                    <Button Style="{StaticResource SecondaryButton}" Content="{DynamicResource t.115}" ui:Ui.Icon="{StaticResource IcZip}" Command="{Binding ExportLogsCommand}" Margin="0,0,10,0" ToolTip="{DynamicResource t.116}" />
                    <Button Style="{StaticResource SecondaryButton}" Content="{DynamicResource t.117}" ui:Ui.Icon="{StaticResource IcBug}" Command="{Binding ReportBugCommand}" Margin="0,0,10,0" />
                    <Button Style="{StaticResource IconButton}" Content="{StaticResource IcRefresh}" Command="{Binding RefreshLogsCommand}" ToolTip="{DynamicResource t.118}" />
                </WrapPanel>
                <Border Style="{StaticResource Card}" Padding="2">
                    <TextBox Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True" FontFamily="{StaticResource Mono}" FontSize="12" Height="Auto" VerticalContentAlignment="Top"
                             TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" x:Name="LogBox">
                        <TextBox.Template>
                            <ControlTemplate TargetType="TextBox">
                                <ScrollViewer x:Name="PART_ContentHost" Margin="12,10" />
                            </ControlTemplate>
                        </TextBox.Template>
                    </TextBox>
                </Border>
            </DockPanel>

            <!-- ============ À PROPOS ============ -->
            <ScrollViewer Style="{StaticResource Page}" VerticalScrollBarVisibility="Auto" Visibility="{Binding IsAbout, Converter={StaticResource Vis}}">
                <StackPanel Margin="{StaticResource PadPage}" MaxWidth="820" HorizontalAlignment="Left">
                    <DockPanel Style="{StaticResource PageHeader}">
                        <Button DockPanel.Dock="Left" Style="{StaticResource IconButton}" Content="{StaticResource IcBack}" Command="{Binding GoBackCommand}" ToolTip="{DynamicResource t.056}" Margin="0,0,14,0" VerticalAlignment="Center" />
                        <StackPanel>
                            <TextBlock Style="{StaticResource Kicker}" Text="{DynamicResource t.119}" Foreground="{DynamicResource Accent}" />
                            <TextBlock Style="{StaticResource Title}" Text="{DynamicResource t.120}" />
                        </StackPanel>
                    </DockPanel>
                    <UniformGrid Columns="4" Margin="0,0,0,14">
                        <UniformGrid.Resources>
                            <Style TargetType="Border" BasedOn="{StaticResource Card}"><Setter Property="Margin" Value="0,0,10,0" /></Style>
                        </UniformGrid.Resources>
                        <Border><StackPanel><TextBlock Style="{StaticResource Kicker}" Text="LAUNCHER" /><TextBlock Style="{StaticResource BigNumber}" FontSize="26" Text="{Binding LauncherVersion}" /></StackPanel></Border>
                        <Border><StackPanel><TextBlock Style="{StaticResource Kicker}" Text="PACK" /><TextBlock Style="{StaticResource BigNumber}" FontSize="26" Text="{Binding PackVersion}" /></StackPanel></Border>
                        <Border><StackPanel><TextBlock Style="{StaticResource Kicker}" Text="MINECRAFT" /><TextBlock Style="{StaticResource BigNumber}" FontSize="26" Text="{Binding MinecraftVersion}" /></StackPanel></Border>
                        <Border Margin="0"><StackPanel><TextBlock Style="{StaticResource Kicker}" Text="NEOFORGE" /><TextBlock Style="{StaticResource BigNumber}" FontSize="26" Text="{Binding NeoForgeVersion}" /></StackPanel></Border>
                    </UniformGrid>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Style="{StaticResource H3}" Text="{DynamicResource t.121}" Margin="0,0,0,12" />
                            <WrapPanel>
                                <Button Style="{StaticResource SecondaryButton}" Content="GitHub" ui:Ui.Icon="{StaticResource IcCode}" Command="{Binding OpenLinkCommand}" CommandParameter="{Binding GithubUrl}" Margin="0,0,10,0" />
                                <Button Style="{StaticResource SecondaryButton}" Content="{DynamicResource t.117}" ui:Ui.Icon="{StaticResource IcBug}" Command="{Binding ReportBugCommand}" Margin="0,0,10,0" />
                                <Button Style="{StaticResource SecondaryButton}" Content="{DynamicResource t.122}" ui:Ui.Icon="{StaticResource IcStar}" Command="{Binding OpenLinkCommand}" CommandParameter="https://github.com/Robocnop/create-warfare/issues/new?title=%5BSuggestion%5D%20" Margin="0,0,10,0" />
                                <Button Style="{StaticResource SecondaryButton}" Content="Discord" ui:Ui.Icon="{StaticResource IcPeople}" Command="{Binding OpenLinkCommand}" CommandParameter="{Binding DiscordUrl}" Margin="0,0,10,0" Visibility="{Binding HasDiscord, Converter={StaticResource Vis}}" />
                                <Button Style="{StaticResource SecondaryButton}" Content="{DynamicResource t.005}" ui:Ui.Icon="{StaticResource IcGlobe}" Command="{Binding OpenLinkCommand}" CommandParameter="{Binding WebsiteUrl}" Visibility="{Binding HasWebsite, Converter={StaticResource Vis}}" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Style="{StaticResource H3}" Text="{DynamicResource t.123}" Margin="0,0,0,10" />
                            <TextBlock Style="{StaticResource Body}" FontFamily="{StaticResource Mono}" FontSize="13" LineHeight="22"
                                       Text="{DynamicResource t.124}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource H3}" Text="{DynamicResource t.125}" Margin="0,0,0,10" />
                            <TextBlock Style="{StaticResource Body}" LineHeight="22"
                                       Text="{DynamicResource t.126}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ============ VISIONNEUSE (galerie) ============ -->
            <Grid Visibility="{Binding IsLightboxOpen, Converter={StaticResource Vis}}" Background="{DynamicResource Overlay}" Style="{StaticResource Page}">
                <Image Source="{Binding LightboxImage}" Stretch="Uniform" Margin="72,56,72,84" />
                <Button Style="{StaticResource IconButton}" Content="{StaticResource IcClose}" Command="{Binding CloseLightboxCommand}" ToolTip="{DynamicResource t.127}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="16" />
                <Button Style="{StaticResource IconButton}" Content="{StaticResource IcChevronLeft}" Command="{Binding LightboxPrevCommand}" ToolTip="{DynamicResource t.128}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="16" Width="48" Height="48" />
                <Button Style="{StaticResource IconButton}" Content="{StaticResource IcChevronRight}" Command="{Binding LightboxNextCommand}" ToolTip="{DynamicResource t.129}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="16" Width="48" Height="48" />
                <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,24">
                    <TextBlock Text="{Binding LightboxCaption}" FontSize="15" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding LightboxCounter}" Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                </StackPanel>
            </Grid>

            <!-- ============ TOAST ============ -->
            <Border Style="{StaticResource GlassCard}" Background="{DynamicResource SurfaceHi}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="24" Padding="0" MaxWidth="520"
                    Visibility="{Binding HasToast, Converter={StaticResource Vis}}">
                <DockPanel>
                    <Border DockPanel.Dock="Left" Width="4" CornerRadius="12,0,0,12">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource Accent}" />
                                <Style.Triggers><DataTrigger Binding="{Binding ToastIsError}" Value="True"><Setter Property="Background" Value="{DynamicResource Error}" /></DataTrigger></Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="{StaticResource IcClose}" Command="{Binding DismissToastCommand}" ToolTip="{DynamicResource t.003}" Margin="4" VerticalAlignment="Top" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="{Binding ToastActionText}" Command="{Binding DismissToastActionCommand}" Height="34" Margin="8,0,0,0"
                            VerticalAlignment="Center" Visibility="{Binding HasToastAction, Converter={StaticResource Vis}}" />
                    <StackPanel Orientation="Horizontal" Margin="16,12,4,12">
                        <TextBlock FontFamily="{StaticResource Icons}" FontSize="16" VerticalAlignment="Top" Margin="0,1,12,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{StaticResource IcDone}" />
                                    <Setter Property="Foreground" Value="{DynamicResource Success}" />
                                    <Style.Triggers><DataTrigger Binding="{Binding ToastIsError}" Value="True"><Setter Property="Text" Value="{StaticResource IcError}" /><Setter Property="Foreground" Value="{DynamicResource Error}" /></DataTrigger></Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding ToastText}" FontSize="13.5" TextWrapping="Wrap" MaxWidth="380" VerticalAlignment="Center" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ============ BOÎTE DE DIALOGUE ============ -->
        <Grid Grid.RowSpan="3" Background="{DynamicResource Scrim}" Visibility="{Binding IsDialogOpen, Converter={StaticResource Vis}}" Style="{StaticResource Page}">
            <Border Style="{StaticResource Card}" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource LineStrong}" Width="500" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="28,24">
                <StackPanel>
                    <TextBlock Style="{StaticResource H2}" Text="{Binding DialogTitle}" Margin="0,0,0,10" />
                    <TextBlock Style="{StaticResource Body}" Text="{Binding DialogText}" Margin="0,0,0,24" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource GhostButton}" Content="{Binding DialogNo}" Command="{Binding DialogNoCommand}" Margin="0,0,10,0" Visibility="{Binding HasDialogNo, Converter={StaticResource Vis}}" />
                        <Button Content="{Binding DialogYes}" Command="{Binding DialogYesCommand}" x:Name="DialogYesButton">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                    <Setter Property="Height" Value="42" />
                                    <Setter Property="FontSize" Value="16" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DialogIsDanger}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Error}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource Error}" />
                                            <Setter Property="Foreground" Value="White" />
                                            <Setter Property="ui:Ui.HoverBrush" Value="{DynamicResource Error}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ============ PREMIER LANCEMENT ============ -->
        <Grid Grid.RowSpan="3" Visibility="{Binding IsOnboarding, Converter={StaticResource Vis}}" Background="{DynamicResource Bg}" Style="{StaticResource Page}">
            <c:HeroArt ShowTitle="False" Opacity="0.55" />
            <Rectangle Fill="{DynamicResource Scrim}" />
            <Border Style="{StaticResource GlassCard}" Width="620" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="36,32">
                <StackPanel>
                    <TextBlock Style="{StaticResource Kicker}" Text="{DynamicResource t.130}" Foreground="{DynamicResource Accent}" />
                    <TextBlock FontFamily="{DynamicResource Display}" FontSize="44" FontWeight="Bold"><Run Text="CREATE " /><Run Text="WARFARE" Foreground="{DynamicResource Accent}" /></TextBlock>
                    <TextBlock Style="{StaticResource Body}" Margin="0,8,0,22"
                               Text="{DynamicResource t.131}" />
                    <StackPanel Margin="0,0,0,26">
                        <DockPanel Margin="0,0,0,14">
                            <TextBlock DockPanel.Dock="Left" Text="{StaticResource IcFolder}" FontFamily="{StaticResource Icons}" FontSize="18" Foreground="{DynamicResource Accent}" Width="34" />
                            <StackPanel><TextBlock Style="{StaticResource H3}" FontSize="15" Text="{DynamicResource t.068}" /><TextBlock Style="{StaticResource Body}" Text="{Binding InstancePath}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" /></StackPanel>
                        </DockPanel>
                        <DockPanel Margin="0,0,0,14">
                            <TextBlock DockPanel.Dock="Left" Text="{StaticResource IcMemory}" FontFamily="{StaticResource Icons}" FontSize="18" Foreground="{DynamicResource Accent}" Width="34" />
                            <StackPanel><TextBlock Style="{StaticResource H3}" FontSize="15" Text="{DynamicResource t.132}" /><TextBlock Style="{StaticResource Body}" Text="{Binding RamAdvice}" /></StackPanel>
                        </DockPanel>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="{StaticResource IcServer}" FontFamily="{StaticResource Icons}" FontSize="18" Foreground="{DynamicResource Accent}" Width="34" />
                            <StackPanel><TextBlock Style="{StaticResource H3}" FontSize="15" Text="{DynamicResource t.133}" /><TextBlock Style="{StaticResource Body}" Text="{Binding ServerAddress}" FontFamily="{StaticResource Mono}" /></StackPanel>
                        </DockPanel>
                    </StackPanel>
                    <Button Style="{StaticResource PrimaryButton}" Content="{DynamicResource t.134}" ui:Ui.Icon="{StaticResource IcChevronRight}" Command="{Binding FinishOnboardingCommand}" HorizontalAlignment="Stretch" />
                </StackPanel>
            </Border>
        </Grid>
        <!-- Fondu au changement de thème : capture de l'ancien rendu, effacée en douceur (MainWindow.xaml.cs) -->
        <Border x:Name="ThemeFade" Grid.RowSpan="3" IsHitTestVisible="False" Visibility="Collapsed">
            <Image x:Name="ThemeFadeImage" Stretch="Fill" />
        </Border>
    </Grid>
</Window>
