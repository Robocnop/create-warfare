<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Noël : vert sapin profond, rouge et or. Mêmes clés dans chaque palette : ThemeManager remplace ce dictionnaire. -->
    <SolidColorBrush x:Key="Bg" Color="#0B120F" />
    <Color x:Key="BgColor">#0B120F</Color>
    <SolidColorBrush x:Key="Panel" Color="#101A15" />
    <Color x:Key="PanelColor">#101A15</Color>
    <SolidColorBrush x:Key="Row" Color="#13201A" />
    <Color x:Key="RowColor">#13201A</Color>
    <SolidColorBrush x:Key="Surface" Color="#15231C" />
    <Color x:Key="SurfaceColor">#15231C</Color>
    <SolidColorBrush x:Key="SurfaceHi" Color="#1D2E25" />
    <Color x:Key="SurfaceHiColor">#1D2E25</Color>
    <SolidColorBrush x:Key="Line" Color="#22352B" />
    <Color x:Key="LineColor">#22352B</Color>
    <SolidColorBrush x:Key="LineStrong" Color="#335244" />
    <Color x:Key="LineStrongColor">#335244</Color>
    <SolidColorBrush x:Key="Text" Color="#F1F4EF" />
    <Color x:Key="TextColor">#F1F4EF</Color>
    <SolidColorBrush x:Key="Muted" Color="#9FB2A6" />
    <Color x:Key="MutedColor">#9FB2A6</Color>
    <SolidColorBrush x:Key="Dim" Color="#66786C" />
    <Color x:Key="DimColor">#66786C</Color>
    <SolidColorBrush x:Key="Accent" Color="#E5484D" />
    <Color x:Key="AccentColor">#E5484D</Color>
    <SolidColorBrush x:Key="AccentHover" Color="#F06A6E" />
    <Color x:Key="AccentHoverColor">#F06A6E</Color>
    <SolidColorBrush x:Key="AccentSoft" Color="#26E5484D" />
    <Color x:Key="AccentSoftColor">#26E5484D</Color>
    <SolidColorBrush x:Key="Primary" Color="#D4A934" />
    <Color x:Key="PrimaryColor">#D4A934</Color>
    <SolidColorBrush x:Key="PrimaryHover" Color="#E6C05A" />
    <Color x:Key="PrimaryHoverColor">#E6C05A</Color>
    <SolidColorBrush x:Key="PrimaryText" Color="#1A1204" />
    <Color x:Key="PrimaryTextColor">#1A1204</Color>
    <SolidColorBrush x:Key="Yellow" Color="#D4A934" />
    <Color x:Key="YellowColor">#D4A934</Color>
    <SolidColorBrush x:Key="YellowHover" Color="#E6C05A" />
    <Color x:Key="YellowHoverColor">#E6C05A</Color>
    <SolidColorBrush x:Key="Success" Color="#4CC38A" />
    <Color x:Key="SuccessColor">#4CC38A</Color>
    <SolidColorBrush x:Key="Warning" Color="#E6C05A" />
    <Color x:Key="WarningColor">#E6C05A</Color>
    <SolidColorBrush x:Key="Error" Color="#F06A6E" />
    <Color x:Key="ErrorColor">#F06A6E</Color>
    <SolidColorBrush x:Key="Info" Color="#7FC8F8" />
    <Color x:Key="InfoColor">#7FC8F8</Color>
    <SolidColorBrush x:Key="Hover" Color="#18281F" />
    <Color x:Key="HoverColor">#18281F</Color>
    <SolidColorBrush x:Key="CaptionHover" Color="#1E3127" />
    <Color x:Key="CaptionHoverColor">#1E3127</Color>
    <SolidColorBrush x:Key="Overlay" Color="#E60B120F" />
    <Color x:Key="OverlayColor">#E60B120F</Color>
    <SolidColorBrush x:Key="Scrim" Color="#990B120F" />
    <Color x:Key="ScrimColor">#990B120F</Color>
    <SolidColorBrush x:Key="Focus" Color="#E6C05A" />
    <Color x:Key="FocusColor">#E6C05A</Color>
    <FontFamily x:Key="Display">pack://application:,,,/Assets/Fonts/#Rajdhani</FontFamily>
    <sys:Double x:Key="PrimaryFontSize">22</sys:Double>
    <Visibility x:Key="HalloweenVis">Collapsed</Visibility>
    <Visibility x:Key="ChristmasVis">Visible</Visibility>
    <Visibility x:Key="SummerVis">Collapsed</Visibility>
</ResourceDictionary>
