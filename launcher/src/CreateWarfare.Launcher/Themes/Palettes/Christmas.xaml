<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Noël : bleu nuit, rouge profond et blanc, or pour le focus. Mêmes clés dans chaque palette : ThemeManager remplace ce dictionnaire. -->
    <SolidColorBrush x:Key="Bg" Color="#0A0F1C" />
    <Color x:Key="BgColor">#0A0F1C</Color>
    <SolidColorBrush x:Key="Panel" Color="#0E1526" />
    <Color x:Key="PanelColor">#0E1526</Color>
    <SolidColorBrush x:Key="Row" Color="#111A2E" />
    <Color x:Key="RowColor">#111A2E</Color>
    <SolidColorBrush x:Key="Surface" Color="#131D33" />
    <Color x:Key="SurfaceColor">#131D33</Color>
    <SolidColorBrush x:Key="SurfaceHi" Color="#1B2843" />
    <Color x:Key="SurfaceHiColor">#1B2843</Color>
    <SolidColorBrush x:Key="Line" Color="#1E2B47" />
    <Color x:Key="LineColor">#1E2B47</Color>
    <SolidColorBrush x:Key="LineStrong" Color="#31446B" />
    <Color x:Key="LineStrongColor">#31446B</Color>
    <SolidColorBrush x:Key="Text" Color="#F3F6FB" />
    <Color x:Key="TextColor">#F3F6FB</Color>
    <SolidColorBrush x:Key="Muted" Color="#A7B4CC" />
    <Color x:Key="MutedColor">#A7B4CC</Color>
    <SolidColorBrush x:Key="Dim" Color="#6E7C9C" />
    <Color x:Key="DimColor">#6E7C9C</Color>
    <SolidColorBrush x:Key="Accent" Color="#F2555A" />
    <Color x:Key="AccentColor">#F2555A</Color>
    <SolidColorBrush x:Key="AccentHover" Color="#FF7377" />
    <Color x:Key="AccentHoverColor">#FF7377</Color>
    <SolidColorBrush x:Key="AccentSoft" Color="#29F2555A" />
    <Color x:Key="AccentSoftColor">#29F2555A</Color>
    <SolidColorBrush x:Key="Primary" Color="#C62233" />
    <Color x:Key="PrimaryColor">#C62233</Color>
    <SolidColorBrush x:Key="PrimaryHover" Color="#D93445" />
    <Color x:Key="PrimaryHoverColor">#D93445</Color>
    <SolidColorBrush x:Key="PrimaryText" Color="#FFFFFF" />
    <Color x:Key="PrimaryTextColor">#FFFFFF</Color>
    <SolidColorBrush x:Key="Yellow" Color="#F2C75C" />
    <Color x:Key="YellowColor">#F2C75C</Color>
    <SolidColorBrush x:Key="YellowHover" Color="#F7D888" />
    <Color x:Key="YellowHoverColor">#F7D888</Color>
    <SolidColorBrush x:Key="Success" Color="#5ED19A" />
    <Color x:Key="SuccessColor">#5ED19A</Color>
    <SolidColorBrush x:Key="Warning" Color="#F2C75C" />
    <Color x:Key="WarningColor">#F2C75C</Color>
    <SolidColorBrush x:Key="Error" Color="#FF7377" />
    <Color x:Key="ErrorColor">#FF7377</Color>
    <SolidColorBrush x:Key="Info" Color="#8EC5FF" />
    <Color x:Key="InfoColor">#8EC5FF</Color>
    <SolidColorBrush x:Key="Hover" Color="#16213A" />
    <Color x:Key="HoverColor">#16213A</Color>
    <SolidColorBrush x:Key="CaptionHover" Color="#1C2946" />
    <Color x:Key="CaptionHoverColor">#1C2946</Color>
    <SolidColorBrush x:Key="Overlay" Color="#E60A0F1C" />
    <Color x:Key="OverlayColor">#E60A0F1C</Color>
    <SolidColorBrush x:Key="Scrim" Color="#990A0F1C" />
    <Color x:Key="ScrimColor">#990A0F1C</Color>
    <SolidColorBrush x:Key="Focus" Color="#F7D888" />
    <Color x:Key="FocusColor">#F7D888</Color>
    <FontFamily x:Key="Display">pack://application:,,,/Assets/Fonts/#Rajdhani</FontFamily>
    <sys:Double x:Key="PrimaryFontSize">22</sys:Double>
    <Visibility x:Key="EasterVis">Collapsed</Visibility>
    <Visibility x:Key="HalloweenVis">Collapsed</Visibility>
    <Visibility x:Key="ChristmasVis">Visible</Visibility>
    <Visibility x:Key="SummerVis">Collapsed</Visibility>
</ResourceDictionary>
