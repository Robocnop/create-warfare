    <SolidColorBrush x:Key="Error" Color="#E5484D" />
    <Color x:Key="ErrorColor">#E5484D</Color>
    <SolidColorBrush x:Key="Info" Color="#58A6FF" />
    <Color x:Key="InfoColor">#58A6FF</Color>
    <SolidColorBrush x:Key="Hover" Color="#1F242D" />
    <Color x:Key="HoverColor">#1F242D</Color>
    <SolidColorBrush x:Key="CaptionHover" Color="#252B36" />
    <Color x:Key="CaptionHoverColor">#252B36</Color>
    <SolidColorBrush x:Key="Overlay" Color="#E60E1014" />
    <Color x:Key="OverlayColor">#E60E1014</Color>
    <SolidColorBrush x:Key="Scrim" Color="#990E1014" />
    <Color x:Key="ScrimColor">#990E1014</Color>
    <SolidColorBrush x:Key="Focus" Color="#FFB866" />
    <Color x:Key="FocusColor">#FFB866</Color>
    <FontFamily x:Key="Display">pack://application:,,,/Assets/Fonts/#Rajdhani</FontFamily>
    <sys:Double x:Key="PrimaryFontSize">22</sys:Double>
    <Visibility x:Key="HalloweenVis">Collapsed</Visibility>
    <Visibility x:Key="ChristmasVis">Collapsed</Visibility>
    <Visibility x:Key="SummerVis">Collapsed</Visibility>
</ResourceDictionary>
