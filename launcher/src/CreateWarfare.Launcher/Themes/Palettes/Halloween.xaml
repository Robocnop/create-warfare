<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Halloween : noir violacé, orange citrouille, titres en Creepster. Mêmes clés dans chaque palette : ThemeManager remplace ce dictionnaire. -->
    <SolidColorBrush x:Key="Bg" Color="#0D0912" />
    <Color x:Key="BgColor">#0D0912</Color>
    <SolidColorBrush x:Key="Panel" Color="#140D1C" />
    <Color x:Key="PanelColor">#140D1C</Color>
    <SolidColorBrush x:Key="Row" Color="#180F22" />
    <Color x:Key="RowColor">#180F22</Color>
    <SolidColorBrush x:Key="Surface" Color="#1A1124" />
    <Color x:Key="SurfaceColor">#1A1124</Color>
    <SolidColorBrush x:Key="SurfaceHi" Color="#24172F" />
    <Color x:Key="SurfaceHiColor">#24172F</Color>
    <SolidColorBrush x:Key="Line" Color="#2A1C35" />
    <Color x:Key="LineColor">#2A1C35</Color>
    <SolidColorBrush x:Key="LineStrong" Color="#45294F" />
    <Color x:Key="LineStrongColor">#45294F</Color>
    <SolidColorBrush x:Key="Text" Color="#F2E8E1" />
    <Color x:Key="TextColor">#F2E8E1</Color>
    <SolidColorBrush x:Key="Muted" Color="#A897AB" />
    <Color x:Key="MutedColor">#A897AB</Color>
    <SolidColorBrush x:Key="Dim" Color="#6F5F74" />
    <Color x:Key="DimColor">#6F5F74</Color>
    <SolidColorBrush x:Key="Accent" Color="#FF8A1F" />
    <Color x:Key="AccentColor">#FF8A1F</Color>
    <SolidColorBrush x:Key="AccentHover" Color="#FF9B3D" />
    <Color x:Key="AccentHoverColor">#FF9B3D</Color>
    <SolidColorBrush x:Key="AccentSoft" Color="#26FF8A1F" />
    <Color x:Key="AccentSoftColor">#26FF8A1F</Color>
    <SolidColorBrush x:Key="Primary" Color="#FF7A0F" />
    <Color x:Key="PrimaryColor">#FF7A0F</Color>
    <SolidColorBrush x:Key="PrimaryHover" Color="#FF9B3D" />
    <Color x:Key="PrimaryHoverColor">#FF9B3D</Color>
    <SolidColorBrush x:Key="PrimaryText" Color="#1A0B05" />
    <Color x:Key="PrimaryTextColor">#1A0B05</Color>
    <SolidColorBrush x:Key="Yellow" Color="#FFB020" />
    <Color x:Key="YellowColor">#FFB020</Color>
    <SolidColorBrush x:Key="YellowHover" Color="#FFC657" />
    <Color x:Key="YellowHoverColor">#FFC657</Color>
    <SolidColorBrush x:Key="Success" Color="#7BD148" />
    <Color x:Key="SuccessColor">#7BD148</Color>
    <SolidColorBrush x:Key="Warning" Color="#FFB020" />
    <Color x:Key="WarningColor">#FFB020</Color>
    <SolidColorBrush x:Key="Error" Color="#E5484D" />
    <Color x:Key="ErrorColor">#E5484D</Color>
    <SolidColorBrush x:Key="Info" Color="#B48CFF" />
    <Color x:Key="InfoColor">#B48CFF</Color>
    <SolidColorBrush x:Key="Hover" Color="#21142C" />
    <Color x:Key="HoverColor">#21142C</Color>
    <SolidColorBrush x:Key="CaptionHover" Color="#2B1A38" />
    <Color x:Key="CaptionHoverColor">#2B1A38</Color>
    <SolidColorBrush x:Key="Overlay" Color="#E60D0912" />
    <Color x:Key="OverlayColor">#E60D0912</Color>
    <SolidColorBrush x:Key="Scrim" Color="#990D0912" />
    <Color x:Key="ScrimColor">#990D0912</Color>
    <SolidColorBrush x:Key="Focus" Color="#FFB866" />
    <Color x:Key="FocusColor">#FFB866</Color>
    <FontFamily x:Key="Display">pack://application:,,,/Assets/Fonts/#Creepster</FontFamily>
    <sys:Double x:Key="PrimaryFontSize">26</sys:Double>
    <Visibility x:Key="HalloweenVis">Visible</Visibility>
    <Visibility x:Key="ChristmasVis">Collapsed</Visibility>
    <Visibility x:Key="SummerVis">Collapsed</Visibility>
</ResourceDictionary>
