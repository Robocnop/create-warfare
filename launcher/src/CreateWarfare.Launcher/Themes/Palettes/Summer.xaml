<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Été : crépuscule indigo, turquoise, jaune soleil et corail. Mêmes clés dans chaque palette : ThemeManager remplace ce dictionnaire. -->
    <SolidColorBrush x:Key="Bg" Color="#0E1220" />
    <Color x:Key="BgColor">#0E1220</Color>
    <SolidColorBrush x:Key="Panel" Color="#131829" />
    <Color x:Key="PanelColor">#131829</Color>
    <SolidColorBrush x:Key="Row" Color="#161C2F" />
    <Color x:Key="RowColor">#161C2F</Color>
    <SolidColorBrush x:Key="Surface" Color="#182034" />
    <Color x:Key="SurfaceColor">#182034</Color>
    <SolidColorBrush x:Key="SurfaceHi" Color="#212A42" />
    <Color x:Key="SurfaceHiColor">#212A42</Color>
    <SolidColorBrush x:Key="Line" Color="#242E47" />
    <Color x:Key="LineColor">#242E47</Color>
    <SolidColorBrush x:Key="LineStrong" Color="#37446A" />
    <Color x:Key="LineStrongColor">#37446A</Color>
    <SolidColorBrush x:Key="Text" Color="#FFF6EC" />
    <Color x:Key="TextColor">#FFF6EC</Color>
    <SolidColorBrush x:Key="Muted" Color="#C2B8B5" />
    <Color x:Key="MutedColor">#C2B8B5</Color>
    <SolidColorBrush x:Key="Dim" Color="#857E8A" />
    <Color x:Key="DimColor">#857E8A</Color>
    <SolidColorBrush x:Key="Accent" Color="#2ED3C6" />
    <Color x:Key="AccentColor">#2ED3C6</Color>
    <SolidColorBrush x:Key="AccentHover" Color="#5FE0D6" />
    <Color x:Key="AccentHoverColor">#5FE0D6</Color>
    <SolidColorBrush x:Key="AccentSoft" Color="#262ED3C6" />
    <Color x:Key="AccentSoftColor">#262ED3C6</Color>
    <SolidColorBrush x:Key="Primary" Color="#FF7A59" />
    <Color x:Key="PrimaryColor">#FF7A59</Color>
    <SolidColorBrush x:Key="PrimaryHover" Color="#FF9478" />
    <Color x:Key="PrimaryHoverColor">#FF9478</Color>
    <SolidColorBrush x:Key="PrimaryText" Color="#2A0E05" />
    <Color x:Key="PrimaryTextColor">#2A0E05</Color>
    <SolidColorBrush x:Key="Yellow" Color="#FFC93C" />
    <Color x:Key="YellowColor">#FFC93C</Color>
    <SolidColorBrush x:Key="YellowHover" Color="#FFD76A" />
    <Color x:Key="YellowHoverColor">#FFD76A</Color>
    <SolidColorBrush x:Key="Success" Color="#4FD69C" />
    <Color x:Key="SuccessColor">#4FD69C</Color>
    <SolidColorBrush x:Key="Warning" Color="#FFC93C" />
    <Color x:Key="WarningColor">#FFC93C</Color>
    <SolidColorBrush x:Key="Error" Color="#FF6B6B" />
    <Color x:Key="ErrorColor">#FF6B6B</Color>
    <SolidColorBrush x:Key="Info" Color="#7CC8FF" />
    <Color x:Key="InfoColor">#7CC8FF</Color>
    <SolidColorBrush x:Key="Hover" Color="#1B2238" />
    <Color x:Key="HoverColor">#1B2238</Color>
    <SolidColorBrush x:Key="CaptionHover" Color="#222B45" />
    <Color x:Key="CaptionHoverColor">#222B45</Color>
    <SolidColorBrush x:Key="Overlay" Color="#E60E1220" />
    <Color x:Key="OverlayColor">#E60E1220</Color>
    <SolidColorBrush x:Key="Scrim" Color="#990E1220" />
    <Color x:Key="ScrimColor">#990E1220</Color>
    <SolidColorBrush x:Key="Focus" Color="#FFD76A" />
    <Color x:Key="FocusColor">#FFD76A</Color>
    <FontFamily x:Key="Display">pack://application:,,,/Assets/Fonts/#Rajdhani</FontFamily>
    <sys:Double x:Key="PrimaryFontSize">22</sys:Double>
    <Visibility x:Key="EasterVis">Collapsed</Visibility>
    <Visibility x:Key="HalloweenVis">Collapsed</Visibility>
    <Visibility x:Key="ChristmasVis">Collapsed</Visibility>
    <Visibility x:Key="SummerVis">Visible</Visibility>
</ResourceDictionary>
