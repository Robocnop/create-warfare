<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Été : bleu lagon, sable et coucher de soleil. Mêmes clés dans chaque palette : ThemeManager remplace ce dictionnaire. -->
    <SolidColorBrush x:Key="Bg" Color="#0B1218" />
    <Color x:Key="BgColor">#0B1218</Color>
    <SolidColorBrush x:Key="Panel" Color="#101A22" />
    <Color x:Key="PanelColor">#101A22</Color>
    <SolidColorBrush x:Key="Row" Color="#132029" />
    <Color x:Key="RowColor">#132029</Color>
    <SolidColorBrush x:Key="Surface" Color="#15232D" />
    <Color x:Key="SurfaceColor">#15232D</Color>
    <SolidColorBrush x:Key="SurfaceHi" Color="#1C2E3A" />
    <Color x:Key="SurfaceHiColor">#1C2E3A</Color>
    <SolidColorBrush x:Key="Line" Color="#213441" />
    <Color x:Key="LineColor">#213441</Color>
    <SolidColorBrush x:Key="LineStrong" Color="#30505F" />
    <Color x:Key="LineStrongColor">#30505F</Color>
    <SolidColorBrush x:Key="Text" Color="#EEF5F7" />
    <Color x:Key="TextColor">#EEF5F7</Color>
    <SolidColorBrush x:Key="Muted" Color="#9DB3BD" />
    <Color x:Key="MutedColor">#9DB3BD</Color>
    <SolidColorBrush x:Key="Dim" Color="#647A85" />
    <Color x:Key="DimColor">#647A85</Color>
    <SolidColorBrush x:Key="Accent" Color="#2EC4B6" />
    <Color x:Key="AccentColor">#2EC4B6</Color>
    <SolidColorBrush x:Key="AccentHover" Color="#55D6CA" />
    <Color x:Key="AccentHoverColor">#55D6CA</Color>
    <SolidColorBrush x:Key="AccentSoft" Color="#262EC4B6" />
    <Color x:Key="AccentSoftColor">#262EC4B6</Color>
    <SolidColorBrush x:Key="Primary" Color="#FF9F1C" />
    <Color x:Key="PrimaryColor">#FF9F1C</Color>
    <SolidColorBrush x:Key="PrimaryHover" Color="#FFB54D" />
    <Color x:Key="PrimaryHoverColor">#FFB54D</Color>
    <SolidColorBrush x:Key="PrimaryText" Color="#1A0F02" />
    <Color x:Key="PrimaryTextColor">#1A0F02</Color>
    <SolidColorBrush x:Key="Yellow" Color="#FFBF69" />
    <Color x:Key="YellowColor">#FFBF69</Color>
    <SolidColorBrush x:Key="YellowHover" Color="#FFCF8A" />
    <Color x:Key="YellowHoverColor">#FFCF8A</Color>
    <SolidColorBrush x:Key="Success" Color="#3FB950" />
    <Color x:Key="SuccessColor">#3FB950</Color>
    <SolidColorBrush x:Key="Warning" Color="#FFBF69" />
    <Color x:Key="WarningColor">#FFBF69</Color>
    <SolidColorBrush x:Key="Error" Color="#E5484D" />
    <Color x:Key="ErrorColor">#E5484D</Color>
    <SolidColorBrush x:Key="Info" Color="#4CC9F0" />
    <Color x:Key="InfoColor">#4CC9F0</Color>
    <SolidColorBrush x:Key="Hover" Color="#172A35" />
    <Color x:Key="HoverColor">#172A35</Color>
    <SolidColorBrush x:Key="CaptionHover" Color="#1C3240" />
    <Color x:Key="CaptionHoverColor">#1C3240</Color>
    <SolidColorBrush x:Key="Overlay" Color="#E60B1218" />
    <Color x:Key="OverlayColor">#E60B1218</Color>
    <SolidColorBrush x:Key="Scrim" Color="#990B1218" />
    <Color x:Key="ScrimColor">#990B1218</Color>
    <SolidColorBrush x:Key="Focus" Color="#55D6CA" />
    <Color x:Key="FocusColor">#55D6CA</Color>
    <FontFamily x:Key="Display">pack://application:,,,/Assets/Fonts/#Rajdhani</FontFamily>
    <sys:Double x:Key="PrimaryFontSize">22</sys:Double>
    <Visibility x:Key="HalloweenVis">Collapsed</Visibility>
    <Visibility x:Key="ChristmasVis">Collapsed</Visibility>
    <Visibility x:Key="SummerVis">Visible</Visibility>
</ResourceDictionary>
