<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Design system : tout ce qui ne dépend pas du thème. Les couleurs sont dans Themes/Palettes/*.xaml. -->

    <!-- Polices -->
    <FontFamily x:Key="Sans">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="Mono">Cascadia Mono, Consolas</FontFamily>
    <!-- Un seul jeu d'icônes : Segoe Fluent Icons (Windows 11), Segoe MDL2 Assets en secours (Windows 10). -->
    <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- Échelle typographique -->
    <sys:Double x:Key="FontCaption">12</sys:Double>
    <sys:Double x:Key="FontBody">14</sys:Double>
    <sys:Double x:Key="FontBodyLarge">15</sys:Double>
    <sys:Double x:Key="FontH3">18</sys:Double>
    <sys:Double x:Key="FontH2">24</sys:Double>
    <sys:Double x:Key="FontH1">34</sys:Double>
    <sys:Double x:Key="FontHero">56</sys:Double>

    <!-- Rayons -->
    <CornerRadius x:Key="RadiusS">4</CornerRadius>
    <CornerRadius x:Key="RadiusM">8</CornerRadius>
    <CornerRadius x:Key="RadiusL">12</CornerRadius>
    <CornerRadius x:Key="RadiusPill">999</CornerRadius>

    <!-- Espacements (multiples de 4) -->
    <Thickness x:Key="PadCard">20</Thickness>
    <Thickness x:Key="PadPage">40,32,40,28</Thickness>
    <sys:Double x:Key="Gap">16</sys:Double>

    <!-- Durées d'animation (ms), mises à 0 si Windows demande moins d'animations (Motion.cs) -->
    <Duration x:Key="DurFast">0:0:0.12</Duration>
    <Duration x:Key="DurBase">0:0:0.22</Duration>
    <Duration x:Key="DurSlow">0:0:0.6</Duration>

    <!-- Icônes (glyphes Segoe Fluent / MDL2) -->
    <sys:String x:Key="IcHome">&#xE80F;</sys:String>
    <sys:String x:Key="IcNews">&#xE789;</sys:String>
